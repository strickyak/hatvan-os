package main

import "hal"
import "klib"
import "rbf"

const RBF_CMD_NOP = 0
const RBF_CMD_READ_SECTOR = 1
const RBF_CMD_WRITE_SECTOR = 2
const RBF_CMD_RESOLVE_PATH = 3
const RBF_CMD_READ_FD = 4
const RBF_CMD_READ_FILE = 5
const RBF_CMD_GET_FD_INF = 6
const RBF_CMD_READ_SB = 7
const RBF_CMD_CREATE_FILE = 8
const RBF_CMD_WRITE_FILE = 9
const RBF_CMD_DELETE_FILE = 10

// Mailbox offsets at $0080 in Task 1 RAM
const MB_CMD = 0x0080
const MB_DRIVE = 0x0081
const MB_TARGET_TASK = 0x0082
const MB_STATUS = 0x0083
const MB_TARGET_ADDR = 0x0084 // 4 bytes: 0x0084..0x0087
const MB_LSN = 0x0088         // 4 bytes: 0x0088..0x008B
const MB_COUNT = 0x008C       // 2 bytes: 0x008C..0x008D
const MB_PARAM = 0x008C       // alias for Count
const MB_AUX_LSN1 = 0x008E    // 2 bytes: 0x008E..0x008F
const MB_AUX_LSN2 = 0x0090    // 2 bytes: 0x0090..0x0091
const MB_FILE_POS = 0x0092    // 4 bytes: 0x0092..0x0095
const MB_PATH_STR = 0x0098    // 32 bytes: 0x0098..0x00B7
const MB_OUT_WORD1 = 0x00B8   // 2 bytes: 0x00B8..0x00B9
const MB_OUT_BYTE1 = 0x00BA   // 1 byte: 0x00BA
const MB_OUT_BYTE2 = 0x00BB   // 1 byte: 0x00BB
const MB_OUT_LONG1 = 0x00BC   // 4 bytes: 0x00BC..0x00BF

var localBuf [256]byte

func readW16(addr word) word {
	hi := word(peekb(addr))
	lo := word(peekb(addr + 1))
	return (hi << 8) | lo
}

func readW32(addr word) word {
	b0 := word(peekb(addr))
	b1 := word(peekb(addr + 1))
	b2 := word(peekb(addr + 2))
	b3 := word(peekb(addr + 3))
	res := (b2 << 8) | b3
	if sizeof[word]() > 2 {
		res = (b0 << 24) | (b1 << 16) | res
	}
	return res
}

func dispatch() {
	cmd := peekb(MB_CMD)

	if cmd == RBF_CMD_NOP {
		pokeb(MB_STATUS, 0)
		return
	}

	if cmd == RBF_CMD_READ_SECTOR {
		drive := peekb(MB_DRIVE)
		targetTask := peekb(MB_TARGET_TASK)
		targetAddr := readW32(MB_TARGET_ADDR)
		lsn := readW32(MB_LSN)
		st := hal.DiskTransfer(drive, lsn, targetTask, targetAddr, 0)
		if st == 1 {
			pokeb(MB_STATUS, 0)
		} else {
			pokeb(MB_STATUS, 244)
		}
		return
	}

	if cmd == RBF_CMD_WRITE_SECTOR {
		drive := peekb(MB_DRIVE)
		targetTask := peekb(MB_TARGET_TASK)
		targetAddr := readW32(MB_TARGET_ADDR)
		lsn := readW32(MB_LSN)
		st := hal.DiskTransfer(drive, lsn, targetTask, targetAddr, 1)
		if st == 1 {
			pokeb(MB_STATUS, 0)
		} else {
			pokeb(MB_STATUS, 244)
		}
		return
	}

	if cmd == RBF_CMD_RESOLVE_PATH {
		drive := peekb(MB_DRIVE)
		isExec := peekb(MB_PARAM)
		cwdLSN := readW16(MB_AUX_LSN1)
		cxdLSN := readW16(MB_AUX_LSN2)
		path := (*byte)(MB_PATH_STR)

		finalDrive, fdLSN := rbf.RBFResolvePath(path, drive, cwdLSN, cxdLSN, isExec)
		if finalDrive == 0xFF || fdLSN == 0 {
			pokeb(MB_STATUS, 216) // E_PNNF
			return
		}

		var fd rbf.RBFFileDescriptor
		st := rbf.RBFReadFD(finalDrive, fdLSN, &fd)
		if st != 1 {
			pokeb(MB_STATUS, 244) // E_READ
			return
		}

		pokeb(MB_STATUS, 0)
		pokeb(MB_DRIVE, finalDrive)
		pokeb(MB_OUT_WORD1, byte(fdLSN>>8))
		pokeb(MB_OUT_WORD1+1, byte(fdLSN))
		pokeb(MB_OUT_BYTE1, fd.Attributes)
		pokeb(MB_OUT_LONG1, 0)
		pokeb(MB_OUT_LONG1+1, 0)
		pokeb(MB_OUT_LONG1+2, byte(fd.FileSize>>8))
		pokeb(MB_OUT_LONG1+3, byte(fd.FileSize))
		if sizeof[word]() > 2 {
			pokeb(MB_OUT_LONG1, byte(fd.FileSize>>24))
			pokeb(MB_OUT_LONG1+1, byte(fd.FileSize>>16))
		}
		return
	}

	if cmd == RBF_CMD_READ_FD {
		drive := peekb(MB_DRIVE)
		targetTask := peekb(MB_TARGET_TASK)
		targetAddr := readW32(MB_TARGET_ADDR)
		fdLSN := readW32(MB_LSN)

		var fd rbf.RBFFileDescriptor
		st := rbf.RBFReadFD(drive, fdLSN, &fd)
		if st != 1 {
			pokeb(MB_STATUS, 244)
			return
		}
		hal.DMACopy(1, word(&fd), targetTask, targetAddr, word(sizeof[rbf.RBFFileDescriptor]()))
		pokeb(MB_STATUS, 0)
		return
	}

	if cmd == RBF_CMD_READ_FILE {
		drive := peekb(MB_DRIVE)
		targetTask := peekb(MB_TARGET_TASK)
		targetAddr := readW32(MB_TARGET_ADDR)
		fdLSN := readW32(MB_LSN)
		count := readW16(MB_COUNT)
		filePos := readW32(MB_FILE_POS)

		var fd rbf.RBFFileDescriptor
		st := rbf.RBFReadFD(drive, fdLSN, &fd)
		if st != 1 {
			pokeb(MB_STATUS, 244)
			pokeb(MB_OUT_WORD1, 0)
			pokeb(MB_OUT_WORD1+1, 0)
			return
		}

		if filePos >= fd.FileSize {
			pokeb(MB_STATUS, 211) // E_EOF
			pokeb(MB_OUT_WORD1, 0)
			pokeb(MB_OUT_WORD1+1, 0)
			return
		}

		toRead := count
		if filePos+toRead > fd.FileSize {
			toRead = fd.FileSize - filePos
		}

		bytesDone := word(0)
		curPos := filePos

		for bytesDone < toRead {
			logSec := curPos / 256
			secOff := curPos % 256
			physLSN := rbf.RBFLogicalToPhys(&fd, logSec)
			if physLSN == 0 {
				break
			}

			chunk := 256 - secOff
			rem := toRead - bytesDone
			if chunk > rem {
				chunk = rem
			}

			if secOff == 0 && chunk == 256 {
				st = hal.DiskTransfer(drive, physLSN, targetTask, targetAddr+bytesDone, 0)
				if st != 1 {
					break
				}
			} else {
				st = hal.DiskTransfer(drive, physLSN, 1, word(&localBuf[0]), 0)
				if st != 1 {
					break
				}
				hal.DMACopy(1, word(&localBuf[0])+secOff, targetTask, targetAddr+bytesDone, chunk)
			}

			bytesDone += chunk
			curPos += chunk
		}

		pokeb(MB_STATUS, 0)
		pokeb(MB_OUT_WORD1, byte(bytesDone>>8))
		pokeb(MB_OUT_WORD1+1, byte(bytesDone))
		return
	}

	if cmd == RBF_CMD_GET_FD_INF {
		drive := peekb(MB_DRIVE)
		targetTask := peekb(MB_TARGET_TASK)
		targetAddr := readW32(MB_TARGET_ADDR)
		fdLSN := readW32(MB_LSN)
		count := readW16(MB_COUNT)

		st := rbf.RBFGetFDInf(drive, fdLSN, targetTask, targetAddr, count)
		pokeb(MB_STATUS, st)
		return
	}

	if cmd == RBF_CMD_READ_SB {
		drive := peekb(MB_DRIVE)
		targetTask := peekb(MB_TARGET_TASK)
		targetAddr := readW32(MB_TARGET_ADDR)

		var sb rbf.RBFSuperblock
		st := rbf.RBFReadSuperblock(drive, &sb)
		if st == 1 {
			hal.DMACopy(1, word(&sb), targetTask, targetAddr, word(sizeof[rbf.RBFSuperblock]()))
			pokeb(MB_STATUS, 0)
		} else {
			pokeb(MB_STATUS, 244)
		}
		return
	}

	if cmd == RBF_CMD_CREATE_FILE {
		drive := peekb(MB_DRIVE)
		mode := peekb(MB_PARAM)
		cwdLSN := readW16(MB_AUX_LSN1)
		path := (*byte)(MB_PATH_STR)

		pDrive, parentFDLSN, fileName := rbf.RBFResolveParent(path, drive, cwdLSN)
		if pDrive == 0xFF || parentFDLSN == 0 {
			pokeb(MB_STATUS, 216) // E_PNNF
			return
		}

		newFDLSN, err := rbf.RBFCreateFile(pDrive, parentFDLSN, fileName, mode)
		if err != 0 {
			pokeb(MB_STATUS, err)
			return
		}

		pokeb(MB_STATUS, 0)
		pokeb(MB_DRIVE, pDrive)
		pokeb(MB_OUT_WORD1, byte(newFDLSN>>8))
		pokeb(MB_OUT_WORD1+1, byte(newFDLSN))
		pokeb(MB_OUT_BYTE1, mode)
		pokeb(MB_OUT_LONG1, 0)
		pokeb(MB_OUT_LONG1+1, 0)
		pokeb(MB_OUT_LONG1+2, 0)
		pokeb(MB_OUT_LONG1+3, 0)
		return
	}

	if cmd == RBF_CMD_WRITE_FILE {
		drive := peekb(MB_DRIVE)
		srcTask := peekb(MB_TARGET_TASK)
		srcAddr := readW32(MB_TARGET_ADDR)
		fdLSN := readW32(MB_LSN)
		count := readW16(MB_COUNT)
		filePos := readW32(MB_FILE_POS)

		bytesWritten, newSize, err := rbf.RBFWriteFile(drive, fdLSN, filePos, srcTask, srcAddr, count)
		pokeb(MB_STATUS, err)
		pokeb(MB_OUT_WORD1, byte(bytesWritten>>8))
		pokeb(MB_OUT_WORD1+1, byte(bytesWritten))
		pokeb(MB_OUT_LONG1, 0)
		pokeb(MB_OUT_LONG1+1, 0)
		pokeb(MB_OUT_LONG1+2, byte(newSize>>8))
		pokeb(MB_OUT_LONG1+3, byte(newSize))
		if sizeof[word]() > 2 {
			pokeb(MB_OUT_LONG1, byte(newSize>>24))
			pokeb(MB_OUT_LONG1+1, byte(newSize>>16))
		}
		return
	}

	if cmd == RBF_CMD_DELETE_FILE {
		drive := peekb(MB_DRIVE)
		cwdLSN := readW16(MB_AUX_LSN1)
		path := (*byte)(MB_PATH_STR)

		pDrive, parentFDLSN, fileName := rbf.RBFResolveParent(path, drive, cwdLSN)
		if pDrive == 0xFF || parentFDLSN == 0 {
			pokeb(MB_STATUS, 216) // E_PNNF
			return
		}

		err := rbf.RBFDeleteFile(pDrive, parentFDLSN, fileName)
		pokeb(MB_STATUS, err)
		return
	}

	pokeb(MB_STATUS, 214) // E_BMODE
}

func main() {
	for {
		hal.Sleep()
		dispatch()
	}
}
