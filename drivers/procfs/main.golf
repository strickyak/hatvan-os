package main

import "hal"
import "klib"
import "tables"

const MAX_PROCS = 16
const ENV_MAX = 256
const ENV_BUF_SIZE = MAX_PROCS * ENV_MAX

const PROC_FREE = 0
const PROC_READY = 1
const PROC_RUNNING = 2
const PROC_WAITING = 3
const PROC_ZOMBIE = 4

const PROCFS_CMD_NOP = 0
const PROCFS_CMD_OPEN = 1
const PROCFS_CMD_READ = 2
const PROCFS_CMD_WRITE = 3
const PROCFS_CMD_COPY_ENV = 4

// Mailbox layout at $0080 in Task 2 RAM
const MB_CMD = 0x0080
const MB_TARGET_TASK = 0x0081
const MB_STATUS = 0x0082
const MB_CURRENT_PID = 0x0083
const MB_TARGET_ADDR = 0x0084 // 4 bytes: 0x0084..0x0087
const MB_FILE_POS = 0x0088    // 4 bytes: 0x0088..0x008B
const MB_COUNT = 0x008C       // 2 bytes: 0x008C..0x008D
const MB_PROC_ADDR = 0x0090   // 4 bytes: 0x0090..0x0093 (Task 0 ProcTable address)
const MB_PROC_SIZE = 0x0094   // 2 bytes: 0x0094..0x0095 (Task 0 ProcTable size / updated FileSize)
const MB_MODE = 0x0096        // 1 byte:  0x0096 (open mode or file tag)
const MB_PATH_STR = 0x0098    // 32 bytes: 0x0098..0x00B7 (subpath, e.g. "p", "i", "e")
const MB_OUT_SIZE = 0x00B8    // 4 bytes: 0x00B8..0x00BB (FileSize or BytesRead/Written)

var procfsBuf [2048]byte
var procfsSize word
var bufTag byte
var bufPID byte

var Env [ENV_BUF_SIZE]byte
var envWriteBuf [ENV_MAX]byte

func envBase(pid byte) word {
	return word(&Env[0]) + word(pid)*ENV_MAX
}

func readW16(addr word) word {
	hi := word(peekb(addr))
	lo := word(peekb(addr + 1))
	return (hi << 8) | lo
}

func readW32(addr word) word {
	b0 := word(peekb(addr))
	b1 := word(peekb(addr + 1))
	b2 := word(peekb(addr + 2))
	b3 := word(peekb(addr + 3))
	res := (b2 << 8) | b3
	if sizeof[word]() > 2 {
		res = (b0 << 24) | (b1 << 16) | res
	}
	return res
}

func writeW16(addr word, val word) {
	pokeb(addr, byte(val>>8))
	pokeb(addr+1, byte(val))
}

func writeW32(addr word, val word) {
	pokeb(addr, 0)
	pokeb(addr+1, 0)
	pokeb(addr+2, byte(val>>8))
	pokeb(addr+3, byte(val))
	if sizeof[word]() > 2 {
		pokeb(addr, byte(val>>24))
		pokeb(addr+1, byte(val>>16))
	}
}

func bufAppendByte(buf *byte, pos *word, b byte) {
	p := *pos
	if p < 2040 {
		pokeb(word(buf)+p, b)
		*pos = p + 1
	}
}

func bufAppendStr(buf *byte, pos *word, s *byte) {
	p := word(s)
	for {
		c := peekb(p)
		if c == 0 {
			break
		}
		bufAppendByte(buf, pos, c)
		p++
	}
}

var decTmp [4]byte

func bufAppendDec(buf *byte, pos *word, val byte, width byte) {
	n := word(0)
	v := val
	if v == 0 {
		decTmp[0] = '0'
		n = 1
	} else {
		for v > 0 {
			rem := v % 10
			decTmp[n] = '0' + rem
			n++
			v = v / 10
		}
	}
	for n < word(width) {
		bufAppendByte(buf, pos, ' ')
		width--
	}
	for n > 0 {
		n--
		bufAppendByte(buf, pos, decTmp[n])
	}
}

func bufAppendHexWord(buf *byte, pos *word, val word) {
	for i := word(0); i < 4; i++ {
		shift := (3 - i) * 4
		nib := byte((val >> shift) & 0xF)
		if nib < 10 {
			bufAppendByte(buf, pos, '0'+nib)
		} else {
			bufAppendByte(buf, pos, 'A'+nib-10)
		}
	}
}

func formatProcesses(curPID byte) word {
	buf := &procfsBuf[0]
	pos := word(0)

	// Column headers: PID, PPID, TASK, STATE, SP, CMD
	bufAppendStr(buf, &pos, (*byte)("  PID  PPID  TASK  STATE     SP  CMD\n"))

	for i := word(0); i < MAX_PROCS; i++ {
		p := &tables.Shared.ProcTable[i]
		if p.State == PROC_FREE {
			continue
		}
		if pos+50 >= 2040 {
			break
		}

		// PID (column width 5)
		bufAppendDec(buf, &pos, p.PID, 5)
		bufAppendStr(buf, &pos, (*byte)("  "))

		// PPID (column width 4)
		bufAppendDec(buf, &pos, p.ParentPID, 4)
		bufAppendStr(buf, &pos, (*byte)("  "))

		// TASK (column width 4)
		bufAppendDec(buf, &pos, p.TaskID, 4)
		bufAppendStr(buf, &pos, (*byte)("  "))

		// STATE (column width 5)
		if p.PID == curPID {
			bufAppendStr(buf, &pos, (*byte)("RUN  "))
		} else if p.State == PROC_READY {
			bufAppendStr(buf, &pos, (*byte)("READY"))
		} else if p.State == PROC_WAITING {
			bufAppendStr(buf, &pos, (*byte)("WAIT "))
		} else if p.State == PROC_ZOMBIE {
			bufAppendStr(buf, &pos, (*byte)("ZOMB "))
		} else if p.State == PROC_RUNNING {
			bufAppendStr(buf, &pos, (*byte)("RUN  "))
		} else {
			bufAppendStr(buf, &pos, (*byte)("???  "))
		}
		bufAppendStr(buf, &pos, (*byte)("  "))

		// SP ($XXXX)
		bufAppendByte(buf, &pos, '$')
		bufAppendHexWord(buf, &pos, p.SavedSP)
		bufAppendStr(buf, &pos, (*byte)("  "))

		// CMD
		if p.CmdName[0] != 0 {
			bufAppendStr(buf, &pos, &p.CmdName[0])
		} else {
			bufAppendStr(buf, &pos, (*byte)("-"))
		}
		bufAppendByte(buf, &pos, '\n')
	}

	pokeb(word(buf)+pos, 0)
	return pos
}

func formatInfo() word {
	buf := &procfsBuf[0]
	pos := word(0)
	if hal.ARCH == '9' {
		bufAppendStr(buf, &pos, (*byte)("M6809\n"))
	} else if hal.ARCH == 'k' {
		bufAppendStr(buf, &pos, (*byte)("M68000\n"))
	} else if hal.ARCH == 'z' {
		bufAppendStr(buf, &pos, (*byte)("Z80\n"))
	} else if hal.ARCH == 'c' {
		bufAppendStr(buf, &pos, (*byte)("CDP1802\n"))
	} else if hal.ARCH == '5' {
		bufAppendStr(buf, &pos, (*byte)("M6502\n"))
	} else if hal.ARCH == '0' {
		bufAppendStr(buf, &pos, (*byte)("I8086\n"))
	} else {
		bufAppendByte(buf, &pos, hal.ARCH)
		bufAppendByte(buf, &pos, '\n')
	}
	pokeb(word(buf)+pos, 0)
	return pos
}

func formatEnv(curPID byte) word {
	buf := &procfsBuf[0]
	pos := word(0)
	if curPID >= MAX_PROCS {
		pokeb(word(buf), 0)
		return 0
	}

	term := byte('\n')
	if tables.Shared.ProcTable[curPID].LineMode == 1 {
		term = '\r'
	}

	base := envBase(curPID)
	off := word(0)
	for off < ENV_MAX && peekb(base+off) != 0 {
		for off < ENV_MAX {
			c := peekb(base + off)
			off++
			if c == 0 {
				break
			}
			bufAppendByte(buf, &pos, c)
		}
		bufAppendByte(buf, &pos, '=')
		for off < ENV_MAX {
			c := peekb(base + off)
			off++
			if c == 0 {
				break
			}
			bufAppendByte(buf, &pos, c)
		}
		bufAppendByte(buf, &pos, term)
	}

	pokeb(word(buf)+pos, 0)
	return pos
}

func envSetOrRemove(pid byte, keyPtr word, keyLen word, valPtr word, valLen word) byte {
	if pid >= MAX_PROCS {
		return 224 // E_PROCUNDEF
	}
	if keyLen == 0 {
		return 214 // E_BMODE
	}

	base := envBase(pid)
	matchFound := false
	matchStart := word(0)
	matchEnd := word(0)
	pos := word(0)

	for pos < ENV_MAX && peekb(base+pos) != 0 {
		entryStart := pos
		kStart := pos
		for pos < ENV_MAX && peekb(base+pos) != 0 {
			pos++
		}
		kLen := pos - kStart
		if pos < ENV_MAX {
			pos++
		}
		for pos < ENV_MAX && peekb(base+pos) != 0 {
			pos++
		}
		if pos < ENV_MAX {
			pos++
		}
		entryEnd := pos

		if !matchFound && kLen == keyLen {
			same := true
			for i := word(0); i < keyLen; i++ {
				if peekb(base+kStart+i) != peekb(keyPtr+i) {
					same = false
					break
				}
			}
			if same {
				matchFound = true
				matchStart = entryStart
				matchEnd = entryEnd
			}
		}
	}

	endPos := pos

	// "Key=" removes Key from Env
	if valLen == 0 {
		if !matchFound {
			return 0
		}
		oldLen := matchEnd - matchStart
		i := matchEnd
		for i <= endPos {
			pokeb(base+i-oldLen, peekb(base+i))
			i++
		}
		newEnd := endPos - oldLen
		pokeb(base+newEnd, 0)
		if newEnd == 0 {
			pokeb(base+1, 0)
		}
		return 0
	}

	newLen := keyLen + 1 + valLen + 1
	if matchFound {
		oldLen := matchEnd - matchStart
		newEnd := endPos - oldLen + newLen
		if newEnd+1 > ENV_MAX {
			return 207 // E_MEMFUL
		}
		if newLen < oldLen {
			diff := oldLen - newLen
			i := matchEnd
			for i <= endPos {
				pokeb(base+i-diff, peekb(base+i))
				i++
			}
		} else if newLen > oldLen {
			diff := newLen - oldLen
			i := endPos + 1
			for i > matchEnd {
				i--
				pokeb(base+i+diff, peekb(base+i))
			}
		}
		for i := word(0); i < keyLen; i++ {
			pokeb(base+matchStart+i, peekb(keyPtr+i))
		}
		pokeb(base+matchStart+keyLen, 0)
		vDst := base + matchStart + keyLen + 1
		for i := word(0); i < valLen; i++ {
			pokeb(vDst+i, peekb(valPtr+i))
		}
		pokeb(vDst+valLen, 0)
		pokeb(base+newEnd, 0)
		return 0
	}

	// Append new Key=Value at endPos
	newEnd := endPos + newLen
	if newEnd+1 > ENV_MAX {
		return 207 // E_MEMFUL
	}
	for i := word(0); i < keyLen; i++ {
		pokeb(base+endPos+i, peekb(keyPtr+i))
	}
	pokeb(base+endPos+keyLen, 0)
	vDst := base + endPos + keyLen + 1
	for i := word(0); i < valLen; i++ {
		pokeb(vDst+i, peekb(valPtr+i))
	}
	pokeb(vDst+valLen, 0)
	pokeb(base+newEnd, 0)
	return 0
}

func envWrite(pid byte, bufPtr word, count word) byte {
	off := word(0)
	for off < count {
		for off < count {
			c := peekb(bufPtr + off)
			if c != '\r' && c != '\n' && c != 0 {
				break
			}
			off++
		}
		if off >= count {
			break
		}
		lineStart := off
		for off < count {
			c := peekb(bufPtr + off)
			if c == '\r' || c == '\n' || c == 0 {
				break
			}
			off++
		}
		lineLen := off - lineStart
		eqOff := word(0)
		foundEq := false
		for eqOff < lineLen {
			if peekb(bufPtr+lineStart+eqOff) == '=' {
				foundEq = true
				break
			}
			eqOff++
		}
		if !foundEq || eqOff == 0 {
			return 214 // E_BMODE
		}
		keyPtr := bufPtr + lineStart
		keyLen := eqOff
		valPtr := bufPtr + lineStart + eqOff + 1
		valLen := lineLen - (eqOff + 1)
		err := envSetOrRemove(pid, keyPtr, keyLen, valPtr, valLen)
		if err != 0 {
			return err
		}
	}
	return 0
}

func ensureFormatted(tag byte, curPID byte) {
	if tag == 'e' && (bufTag != 'e' || bufPID != curPID) {
		procfsSize = formatEnv(curPID)
		bufTag = 'e'
		bufPID = curPID
	} else if tag == 'i' && bufTag != 'i' {
		procfsSize = formatInfo()
		bufTag = 'i'
		bufPID = 0
	} else if tag == 'p' && (bufTag != 'p' || bufPID != curPID) {
		procfsSize = formatProcesses(curPID)
		bufTag = 'p'
		bufPID = curPID
	}
}

func dispatch() {
	cmd := peekb(MB_CMD)

	if cmd == PROCFS_CMD_NOP {
		pokeb(MB_STATUS, 0)
		return
	}

	if cmd == PROCFS_CMD_OPEN {
		subpath := word(MB_PATH_STR)
		mode := peekb(MB_MODE)
		curPID := peekb(MB_CURRENT_PID)
		c0 := peekb(subpath)
		c1 := peekb(subpath + 1)
		if c0 == 'p' && c1 == 0 {
			if (mode & 2) != 0 {
				pokeb(MB_STATUS, 214) // E_BMODE
				writeW32(MB_OUT_SIZE, 0)
				return
			}
			procfsSize = formatProcesses(curPID)
			bufTag = 'p'
			bufPID = curPID
			writeW32(MB_OUT_SIZE, procfsSize)
			pokeb(MB_STATUS, 0)
			return
		}
		if c0 == 'i' && c1 == 0 {
			if (mode & 2) != 0 {
				pokeb(MB_STATUS, 214) // E_BMODE
				writeW32(MB_OUT_SIZE, 0)
				return
			}
			procfsSize = formatInfo()
			bufTag = 'i'
			bufPID = 0
			writeW32(MB_OUT_SIZE, procfsSize)
			pokeb(MB_STATUS, 0)
			return
		}
		if c0 == 'e' && c1 == 0 {
			procfsSize = formatEnv(curPID)
			bufTag = 'e'
			bufPID = curPID
			writeW32(MB_OUT_SIZE, procfsSize)
			pokeb(MB_STATUS, 0)
			return
		}
		pokeb(MB_STATUS, 216) // E_PNNF
		writeW32(MB_OUT_SIZE, 0)
		return
	}

	if cmd == PROCFS_CMD_READ {
		tag := peekb(MB_MODE)
		curPID := peekb(MB_CURRENT_PID)
		filePos := readW32(MB_FILE_POS)
		count := readW16(MB_COUNT)
		targetTask := peekb(MB_TARGET_TASK)
		targetAddr := readW32(MB_TARGET_ADDR)

		ensureFormatted(tag, curPID)

		if filePos >= procfsSize {
			pokeb(MB_STATUS, 211) // E_EOF
			writeW32(MB_OUT_SIZE, 0)
			return
		}

		toRead := count
		if filePos+toRead > procfsSize {
			toRead = procfsSize - filePos
		}

		srcAddr := word(&procfsBuf[0]) + filePos
		hal.DMACopy(2, srcAddr, targetTask, targetAddr, toRead)

		writeW32(MB_OUT_SIZE, toRead)
		pokeb(MB_STATUS, 0)
		return
	}

	if cmd == PROCFS_CMD_WRITE {
		curPID := peekb(MB_CURRENT_PID)
		srcTask := peekb(MB_TARGET_TASK)
		srcAddr := readW32(MB_TARGET_ADDR)
		count := readW16(MB_COUNT)

		if count == 0 {
			procfsSize = formatEnv(curPID)
			bufTag = 'e'
			bufPID = curPID
			writeW16(MB_PROC_SIZE, procfsSize)
			writeW32(MB_OUT_SIZE, 0)
			pokeb(MB_STATUS, 0)
			return
		}
		if count > ENV_MAX {
			writeW32(MB_OUT_SIZE, 0)
			pokeb(MB_STATUS, 207) // E_MEMFUL
			return
		}

		hal.DMACopy(srcTask, srcAddr, 2, word(&envWriteBuf[0]), count)
		err := envWrite(curPID, word(&envWriteBuf[0]), count)
		if err != 0 {
			writeW32(MB_OUT_SIZE, 0)
			pokeb(MB_STATUS, err)
			return
		}

		procfsSize = formatEnv(curPID)
		bufTag = 'e'
		bufPID = curPID
		writeW16(MB_PROC_SIZE, procfsSize)
		writeW32(MB_OUT_SIZE, count)
		pokeb(MB_STATUS, 0)
		return
	}

	if cmd == PROCFS_CMD_COPY_ENV {
		parentPID := peekb(MB_CURRENT_PID)
		childPID := peekb(MB_TARGET_TASK)
		if parentPID < MAX_PROCS && childPID < MAX_PROCS && parentPID != childPID {
			klib.memcpy((*byte)(envBase(childPID)), (*byte)(envBase(parentPID)), ENV_MAX)
			if bufTag == 'e' && bufPID == childPID {
				bufTag = 0
			}
		}
		pokeb(MB_STATUS, 0)
		return
	}

	pokeb(MB_STATUS, 214) // E_BMODE
}

func main() {
	tables.Init()
	klib.memset(&Env[0], 0, ENV_BUF_SIZE)
	for {
		hal.Sleep()
		dispatch()
	}
}
