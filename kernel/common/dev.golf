package dev

import "hal"
import "klib"

const DEV_NONE = 0
const DEV_TERM = 1
const DEV_LOG = 2
const DEV_NULL = 3
const DEV_DISK = 4

// ParsePathDevice examines path for device prefixes:
// "/term", "/log", "/null", "/d0".."/d3".
// Returns (devType, driveNum, remainingPathPtr).
func ParsePathDevice(path *byte, defaultDrive byte) (byte, byte, *byte) {
	p := word(path)

	// Check for leading slash
	if peekb(p) == '/' {
		// Check /term
		if peekb(p+1) == 't' && peekb(p+2) == 'e' && peekb(p+3) == 'r' && peekb(p+4) == 'm' {
			c := peekb(p + 5)
			if c == 0 || c == '/' || c == ' ' || c == '\r' || c == '\n' {
				return DEV_TERM, 0, (*byte)(p + 5)
			}
		}
		// Check /log
		if peekb(p+1) == 'l' && peekb(p+2) == 'o' && peekb(p+3) == 'g' {
			c := peekb(p + 4)
			if c == 0 || c == '/' || c == ' ' || c == '\r' || c == '\n' {
				return DEV_LOG, 0, (*byte)(p + 4)
			}
		}
		// Check /null
		if peekb(p+1) == 'n' && peekb(p+2) == 'u' && peekb(p+3) == 'l' && peekb(p+4) == 'l' {
			c := peekb(p + 5)
			if c == 0 || c == '/' || c == ' ' || c == '\r' || c == '\n' {
				return DEV_NULL, 0, (*byte)(p + 5)
			}
		}
		// Check /d0 .. /d3
		if peekb(p+1) == 'd' {
			d := peekb(p + 2)
			if d >= '0' && d <= '3' {
				return DEV_DISK, d - '0', (*byte)(p + 3)
			}
		}
		// Absolute path without /d prefix defaults to defaultDrive root
		return DEV_DISK, defaultDrive, path
	}

	// Relative path defaults to DEV_DISK on defaultDrive
	return DEV_DISK, defaultDrive, path
}

// TermRead reads raw binary bytes from the console
func TermRead(task byte, dstAddr word, count word) word {
	for i := word(0); i < count; i++ {
		// Non-blocking poll with yield until character arrives
		c := byte(0)
		for {
			c = hal.GetChar()
			if c != 0 {
				break
			}
		}

		if task == 0 {
			pokeb(dstAddr+i, c)
		} else {
			hal.DMACopy(0, word(&c), task, dstAddr+i, 1)
		}
	}
	return count
}

// TermWrite writes raw binary bytes to the console
func TermWrite(task byte, srcAddr word, count word) word {
	if task == 0 {
		for i := word(0); i < count; i++ {
			hal.PutChar(peekb(srcAddr + i))
		}
	} else {
		for i := word(0); i < count; i++ {
			c := byte(0)
			hal.DMACopy(task, srcAddr+i, 0, word(&c), 1)
			hal.PutChar(c)
		}
	}
	return count
}

// TermReadLn reads a cooked line of text from console into user buffer.
// Returns number of bytes read including line terminator.
func TermReadLn(task byte, dstAddr word, maxLen word, lineMode byte) word {
	count := word(0)
	for {
		c := byte(0)
		for {
			c = hal.GetChar()
			if c != 0 {
				break
			}
		}

		// Handle Return / Newline
		if c == '\r' || c == '\n' {
			endChar := byte('\n')
			if lineMode == 1 {
				endChar = '\r'
			}

			// Echo newline
			hal.PutChar('\r')
			hal.PutChar('\n')

			if task == 0 {
				pokeb(dstAddr+count, endChar)
				pokeb(dstAddr+count+1, 0)
			} else {
				hal.DMACopy(0, word(&endChar), task, dstAddr+count, 1)
				zero := byte(0)
				hal.DMACopy(0, word(&zero), task, dstAddr+count+1, 1)
			}
			return count + 1
		}

		// Handle Backspace / Delete
		if c == 8 || c == 127 {
			if count > 0 {
				count--
				// Visual erase
				hal.PutChar(8)
				hal.PutChar(' ')
				hal.PutChar(8)
			}
			continue
		}

		// Handle Ctrl-D (EOF)
		if c == 4 {
			if count == 0 {
				return 0
			}
			endChar := byte('\n')
			if lineMode == 1 {
				endChar = '\r'
			}

			if task == 0 {
				pokeb(dstAddr+count, endChar)
				pokeb(dstAddr+count+1, 0)
			} else {
				hal.DMACopy(0, word(&endChar), task, dstAddr+count, 1)
				zero := byte(0)
				hal.DMACopy(0, word(&zero), task, dstAddr+count+1, 1)
			}
			return count + 1
		}

		// Regular printable ASCII characters
		if c >= 32 && c <= 126 {
			if count < maxLen-1 {
				if task == 0 {
					pokeb(dstAddr+count, c)
				} else {
					hal.DMACopy(0, word(&c), task, dstAddr+count, 1)
				}
				hal.PutChar(c) // Echo character
				count++
			}
		}
	}
}

// LogWrite writes bytes to diagnostic stderr (port $FF04)
func LogWrite(task byte, srcAddr word, count word) word {
	if task == 0 {
		for i := word(0); i < count; i++ {
			hal.LogChar(peekb(srcAddr + i))
		}
	} else {
		for i := word(0); i < count; i++ {
			c := byte(0)
			hal.DMACopy(task, srcAddr+i, 0, word(&c), 1)
			hal.LogChar(c)
		}
	}
	return count
}

// KLog prints a message from the kernel to the log port (stderr)
// prefixed with "    --  ". If the message does not end in a newline, one is added.
func KLog(msg *byte) {
	prefix := (*byte)("    --  ")
	pPre := word(prefix)
	for {
		c := peekb(pPre)
		if c == 0 {
			break
		}
		hal.LogChar(c)
		pPre++
	}
	p := word(msg)
	lastC := byte(0)
	for {
		c := peekb(p)
		if c == 0 {
			break
		}
		hal.LogChar(c)
		lastC = c
		if c == '\n' {
			if peekb(p+1) != 0 {
				pPre = word(prefix)
				for {
					cp := peekb(pPre)
					if cp == 0 {
						break
					}
					hal.LogChar(cp)
					pPre++
				}
			}
		}
		p++
	}
	if lastC != '\n' {
		hal.LogChar('\n')
	}
}
