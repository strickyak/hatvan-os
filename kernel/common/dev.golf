package dev

import "hal"
import "klib"
import "proc"

const DEV_NONE = 0
const DEV_TERM = 1
const DEV_LOG = 2
const DEV_NULL = 3
const DEV_DISK = 4
const DEV_PROC = 5
const DEV_DUP = 6

const TTY_RING_SIZE = 1024
var ttyRing [1024]byte
var ttyHead word
var ttyTail word
var TermWaitPID byte

// TermRxInterrupt is called by the hardware interrupt handler (trap_irq / trap_level4)
// or polled by TermReadChar. It drains characters from the terminal port into ttyRing
// and wakes up any process waiting on console input.
func TermRxInterrupt() {
	for hal.HasInput() {
		nextHead := (ttyHead + 1) % TTY_RING_SIZE
		if nextHead == ttyTail {
			// Buffer full: drop oldest character so hardware Rx interrupt is de-asserted
			ttyTail = (ttyTail + 1) % TTY_RING_SIZE
		}
		c := hal.GetChar()
		if c == 0 {
			break
		}
		ttyRing[ttyHead] = c
		ttyHead = nextHead
		if TermWaitPID != 0 {
			proc.SetProcState(TermWaitPID, proc.PROC_READY)
			TermWaitPID = 0
		}
	}
}

// TermReadChar reads a single character from the console, yielding to other processes
// while waiting for input.
func TermReadChar() byte {
	for {
		TermRxInterrupt()
		if ttyHead != ttyTail {
			c := ttyRing[ttyTail]
			ttyTail = (ttyTail + 1) % TTY_RING_SIZE
			return c
		}
		TermWaitPID = proc.CurrentPID
		proc.WaitInput()
	}
}


func isPathTerm(c byte) bool {
	return c == 0 || c == '/' || c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == ','
}

func matchDeviceWord(p word, s *byte) word {
	i := word(0)
	sp := word(s)
	for {
		c := peekb(sp + i)
		if c == 0 {
			if isPathTerm(peekb(p + i)) {
				return i
			}
			return 0
		}
		if peekb(p + i) != c {
			return 0
		}
		i++
	}
}

var ParsedDrive byte
var ParsedRemPath *byte

// ParsePathDevice examines path for device prefixes:
// "/term", "/log", "/null", "/proc", "/d0".."/d3".
// Returns devType, and sets ParsedDrive and ParsedRemPath.
func ParsePathDevice(path *byte, defaultDrive byte) byte {
	p := word(path)
	ParsedDrive = defaultDrive
	ParsedRemPath = path

	// Check for leading slash
	if peekb(p) == '/' {
		c1 := peekb(p + 1)
		// Check /0 .. /3 (numbered path dup devices)
		if c1 >= '0' && c1 <= '3' {
			c2 := peekb(p + 2)
			if isPathTerm(c2) {
				rem := p + 2
				if c2 == '/' {
					rem++
				}
				ParsedDrive = c1 - '0'
				ParsedRemPath = (*byte)(rem)
				return DEV_DUP
			}
		} else if c1 == 'd' {
			d := peekb(p + 2)
			if d >= '0' && d <= '3' {
				ParsedDrive = d - '0'
				ParsedRemPath = (*byte)(p + 3)
				return DEV_DISK
			}
		} else if c1 == 't' {
			n := matchDeviceWord(p+1, (*byte)("term"))
			if n > 0 {
				ParsedDrive = 0
				ParsedRemPath = (*byte)(p + 1 + n)
				return DEV_TERM
			}
		} else if c1 == 'p' {
			n := matchDeviceWord(p+1, (*byte)("proc"))
			if n > 0 {
				ParsedDrive = 0
				ParsedRemPath = (*byte)(p + 1 + n)
				return DEV_PROC
			}
		} else if c1 == 'l' {
			n := matchDeviceWord(p+1, (*byte)("log"))
			if n > 0 {
				ParsedDrive = 0
				ParsedRemPath = (*byte)(p + 1 + n)
				return DEV_LOG
			}
		} else if c1 == 'n' {
			n := matchDeviceWord(p+1, (*byte)("null"))
			if n > 0 {
				ParsedDrive = 0
				ParsedRemPath = (*byte)(p + 1 + n)
				return DEV_NULL
			}
		}
		// Absolute path without /d prefix defaults to defaultDrive root
		return DEV_DISK
	}

	// Relative path defaults to DEV_DISK on defaultDrive
	return DEV_DISK
}

// TermRead reads raw binary bytes from the console
func TermRead(task byte, dstAddr word, count word) word {
	for i := word(0); i < count; i++ {
		c := TermReadChar()

		if task == 0 {
			pokeb(dstAddr+i, c)
		} else {
			hal.DMACopy(0, word(&c), task, dstAddr+i, 1)
		}
	}
	return count
}

// TermWrite writes raw binary bytes to the console
func TermWrite(task byte, srcAddr word, count word) word {
	if task == 0 {
		for i := word(0); i < count; i++ {
			hal.PutChar(peekb(srcAddr + i))
		}
	} else {
		for i := word(0); i < count; i++ {
			c := byte(0)
			hal.DMACopy(task, srcAddr+i, 0, word(&c), 1)
			hal.PutChar(c)
		}
	}
	return count
}



var termLineBuf [256]byte

// TermReadLn reads a cooked line of text from console into user buffer.
// Returns number of bytes read including line terminator.
func TermReadLn(task byte, dstAddr word, maxLen word, lineMode byte) word {
	limit := maxLen - 1
	if limit > 254 {
		limit = 254
	}
	count := word(0)
	for {
		c := TermReadChar()

		// Handle Return / Newline
		if c == '\r' || c == '\n' {
			endChar := byte('\n')
			if lineMode == 1 {
				endChar = '\r'
			}

			termLineBuf[count] = endChar
			count++
			termLineBuf[count] = 0

			if task == 0 {
				klib.memcpy((*byte)(dstAddr), &termLineBuf[0], count+1)
			} else {
				hal.DMACopy(0, word(&termLineBuf[0]), task, dstAddr, count+1)
			}
			return count
		}

		// Handle Ctrl-D (EOF)
		if c == 4 {
			if count == 0 {
				return 0
			}
			endChar := byte('\n')
			if lineMode == 1 {
				endChar = '\r'
			}

			termLineBuf[count] = endChar
			count++
			termLineBuf[count] = 0

			if task == 0 {
				klib.memcpy((*byte)(dstAddr), &termLineBuf[0], count+1)
			} else {
				hal.DMACopy(0, word(&termLineBuf[0]), task, dstAddr, count+1)
			}
			return count
		}

		// Regular characters (input from cooked tty)
		if (c >= 32 && c <= 126) || c == '\t' {
			if count < limit {
				termLineBuf[count] = c
				count++
			}
		}
	}
}

// LogWrite writes bytes to diagnostic stderr (port $FF04)
func LogWrite(task byte, srcAddr word, count word) word {
	if task == 0 {
		for i := word(0); i < count; i++ {
			hal.LogChar(peekb(srcAddr + i))
		}
	} else {
		for i := word(0); i < count; i++ {
			c := byte(0)
			hal.DMACopy(task, srcAddr+i, 0, word(&c), 1)
			hal.LogChar(c)
		}
	}
	return count
}

// KLog prints a message from the kernel to the log port (stderr)
// prefixed with "    --  ". If the message does not end in a newline, one is added.
func KLog(msg *byte) {
	prefix := (*byte)("    --  ")
	pPre := word(prefix)
	for {
		c := peekb(pPre)
		if c == 0 {
			break
		}
		hal.LogChar(c)
		pPre++
	}
	p := word(msg)
	lastC := byte(0)
	for {
		c := peekb(p)
		if c == 0 {
			break
		}
		hal.LogChar(c)
		lastC = c
		if c == '\n' {
			if peekb(p+1) != 0 {
				pPre = word(prefix)
				for {
					cp := peekb(pPre)
					if cp == 0 {
						break
					}
					hal.LogChar(cp)
					pPre++
				}
			}
		}
		p++
	}
	if lastC != '\n' {
		hal.LogChar('\n')
	}
}
