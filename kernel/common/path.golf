package path

import "hal"
import "klib"
import "rbf_ipc"
import "procfs_ipc"
import "dev"
import "tables"

const MAX_PATHS = 16

const MODE_READ = 1
const MODE_WRITE = 2
const MODE_EXEC = 4
const MODE_DIR = 0x80

// OS-9 Error Codes
const E_EOF = 211    // End of file
const E_BMODE = 214  // Bad mode
const E_PNNF = 216   // Path name not found
const E_BPNUM = 217  // Bad path number
const E_PTHFUL = 218 // Path table full
const E_READ = 244   // Read error

func GetPath(pathId byte) *tables.PathDesc {
	return &tables.Shared.PathTable[pathId]
}

// PathInit initializes the global open path table in shared memory
func PathInit() {
	for i := word(0); i < MAX_PATHS; i++ {
		pd := &tables.Shared.PathTable[i]
		klib.memset((*byte)(pd), 0, sizeof[tables.PathDesc]())
		pd.BufLSN = 0xFFFF
	}
}

var AllocatedPathId byte

// PathAlloc finds an available slot in PathTable
func PathAlloc() byte {
	for i := word(0); i < MAX_PATHS; i++ {
		pd := &tables.Shared.PathTable[i]
		if pd.RefCount == 0 {
			klib.memset((*byte)(pd), 0, sizeof[tables.PathDesc]())
			pd.RefCount = 1
			pd.BufLSN = 0xFFFF
			return byte(i)
		}
	}
	return 0xFF
}

// PathFree decrements the reference count and frees the slot when zero
func PathFree(pathId byte) {
	if pathId >= MAX_PATHS {
		return
	}
	pd := &tables.Shared.PathTable[pathId]
	if pd.RefCount > 0 {
		pd.RefCount--
		if pd.RefCount == 0 {
			if pd.BufDirty != 0 && pd.DevType == dev.DEV_DISK && pd.BufLSN != 0xFFFF {
				hal.DiskTransfer(pd.Drive, pd.BufLSN, 0, word(&pd.SectorBuf[0]), 1)
				pd.BufDirty = 0
			}
			pd.DevType = dev.DEV_NONE
			pd.BufLSN = 0xFFFF
		}
	}
}

func openDup(task byte, targetProcPath byte) byte {
	if task >= tables.MAX_PROCS || tables.Shared.ProcTable[task].State == 0 {
		return E_BPNUM
	}
	targetPathId := tables.Shared.ProcTable[task].Paths[targetProcPath]
	if targetPathId == 0xFF || targetPathId >= MAX_PATHS {
		return E_BPNUM
	}
	err := SysDup(targetPathId)
	if err != 0 {
		return err
	}
	AllocatedPathId = targetPathId
	return 0
}

func openDisk(pathId byte, pd *tables.PathDesc, pathStr *byte, mode byte, defaultDrive byte, cwdLSN word, cxdLSN word) byte {
	isExec := byte(0)
	if (mode & MODE_EXEC) != 0 {
		isExec = 1
	}

	err := rbf_ipc.ResolvePath(pathStr, defaultDrive, cwdLSN, cxdLSN, isExec)
	if err != 0 || rbf_ipc.ResDrive == 0xFF || rbf_ipc.ResFDLSN == 0 {
		PathFree(pathId)
		return E_PNNF
	}

	pd.Drive = rbf_ipc.ResDrive
	pd.FDLSN = rbf_ipc.ResFDLSN

	// If mode requests directory, verify FD has directory bit set ($80)
	if (mode&MODE_DIR) != 0 && (rbf_ipc.ResAttr&0x80) == 0 {
		PathFree(pathId)
		return E_BMODE
	}

	pd.FileSize = rbf_ipc.ResFileSize
	AllocatedPathId = pathId
	return 0
}

// SysOpen opens a file or device and returns errCode (0 on success, sets AllocatedPathId)
func SysOpen(task byte, pathStr *byte, mode byte, defaultDrive byte, cwdLSN word, cxdLSN word) byte {
	devType := dev.ParsePathDevice(pathStr, defaultDrive)
	drive := dev.ParsedDrive

	if devType == dev.DEV_DUP {
		return openDup(task, drive)
	}

	pathId := PathAlloc()
	if pathId == 0xFF {
		return E_PTHFUL
	}

	pd := &tables.Shared.PathTable[pathId]
	pd.DevType = devType
	pd.Drive = drive
	pd.Mode = mode

	// Terminal, Logger, and Null devices don't require filesystem traversal
	if devType == dev.DEV_TERM || devType == dev.DEV_LOG || devType == dev.DEV_NULL {
		AllocatedPathId = pathId
		return 0
	}
	if devType == dev.DEV_PROC {
		if (mode & MODE_WRITE) != 0 {
			PathFree(pathId)
			return E_BMODE
		}
		AllocatedPathId = pathId
		return 0
	}

	return openDisk(pathId, pd, pathStr, mode, defaultDrive, cwdLSN, cxdLSN)
}

// SysCreate creates or opens a file for writing and returns errCode (0 on success, sets AllocatedPathId)
func SysCreate(task byte, pathStr *byte, mode byte, defaultDrive byte, cwdLSN word, cxdLSN word) byte {
	// For devices (/term, /log, /null, /0../3), create is equivalent to open write
	devType := dev.ParsePathDevice(pathStr, defaultDrive)
	if devType == dev.DEV_TERM || devType == dev.DEV_LOG || devType == dev.DEV_NULL || devType == dev.DEV_DUP {
		return SysOpen(task, pathStr, mode|MODE_WRITE, defaultDrive, cwdLSN, cxdLSN)
	}
	if devType == dev.DEV_PROC {
		return E_BMODE
	}

	err := rbf_ipc.CreateFile(pathStr, defaultDrive, cwdLSN, cxdLSN, mode)
	if err != 0 || rbf_ipc.ResDrive == 0xFF || rbf_ipc.ResFDLSN == 0 {
		return err
	}

	pathId := PathAlloc()
	if pathId == 0xFF {
		return E_PTHFUL
	}

	pd := &tables.Shared.PathTable[pathId]
	pd.DevType = dev.DEV_DISK
	pd.Drive = rbf_ipc.ResDrive
	pd.Mode = mode | MODE_WRITE
	pd.FDLSN = rbf_ipc.ResFDLSN
	pd.FileSize = 0
	pd.FilePos = 0
	AllocatedPathId = pathId
	return 0
}

// SysDelete deletes a file from the disk filesystem
func SysDelete(task byte, pathStr *byte, defaultDrive byte, cwdLSN word, cxdLSN word) byte {
	devType := dev.ParsePathDevice(pathStr, defaultDrive)
	if devType != dev.DEV_DISK {
		return E_BMODE
	}
	return rbf_ipc.DeleteFile(pathStr, defaultDrive, cwdLSN, cxdLSN)
}

// SysClose closes an open path descriptor
func SysClose(pathId byte) byte {
	if pathId >= MAX_PATHS || tables.Shared.PathTable[pathId].RefCount == 0 {
		return E_BPNUM
	}
	PathFree(pathId)
	return 0
}

// SysDup duplicates an open path descriptor by incrementing its reference count
func SysDup(pathId byte) byte {
	if pathId >= MAX_PATHS || tables.Shared.PathTable[pathId].RefCount == 0 {
		return E_BPNUM
	}
	tables.Shared.PathTable[pathId].RefCount++
	return 0
}

func readProc(pd *tables.PathDesc, task byte, ubuf *byte, count word) byte {
	if pd.FilePos >= pd.FileSize {
		TransferredBytes = 0
		return E_EOF
	}
	toRead := count
	if pd.FilePos+toRead > pd.FileSize {
		toRead = pd.FileSize - pd.FilePos
	}
	err := procfs_ipc.Read(pd.FilePos, task, word(ubuf), toRead)
	if err != 0 {
		TransferredBytes = 0
		return err
	}
	pd.FilePos += procfs_ipc.TransferredBytes
	TransferredBytes = procfs_ipc.TransferredBytes
	return 0
}

func readDisk(pd *tables.PathDesc, task byte, ubuf *byte, count word) byte {
	if pd.FilePos >= pd.FileSize {
		TransferredBytes = 0
		return E_EOF
	}
	toRead := count
	if pd.FilePos+toRead > pd.FileSize {
		toRead = pd.FileSize - pd.FilePos
	}
	err := rbf_ipc.ReadFile(pd.Drive, pd.FDLSN, pd.FilePos, task, word(ubuf), toRead)
	if err != 0 {
		TransferredBytes = 0
		return err
	}
	pd.FilePos += rbf_ipc.TransferredBytes
	TransferredBytes = rbf_ipc.TransferredBytes
	return 0
}

var TransferredBytes word

// SysRead reads up to count bytes from pathId into ubuf in task space
func SysRead(pathId byte, task byte, ubuf *byte, count word) byte {
	TransferredBytes = 0
	if pathId >= MAX_PATHS || tables.Shared.PathTable[pathId].RefCount == 0 {
		return E_BPNUM
	}
	pd := &tables.Shared.PathTable[pathId]
	if (pd.Mode&(MODE_READ|MODE_EXEC)) == 0 && pd.DevType != dev.DEV_TERM {
		return E_BMODE
	}

	if pd.DevType == dev.DEV_TERM {
		TransferredBytes = dev.TermRead(task, word(ubuf), count)
		return 0
	}
	if pd.DevType == dev.DEV_LOG || pd.DevType == dev.DEV_NULL {
		return 0 // EOF
	}

	if pd.DevType == dev.DEV_PROC {
		return readProc(pd, task, ubuf, count)
	}
	return readDisk(pd, task, ubuf, count)
}

func writeDisk(pd *tables.PathDesc, task byte, ubuf *byte, count word) byte {
	err := rbf_ipc.WriteFile(pd.Drive, pd.FDLSN, pd.FilePos, task, word(ubuf), count)
	if err != 0 {
		TransferredBytes = 0
		return err
	}
	pd.FilePos += rbf_ipc.TransferredBytes
	if pd.FilePos > pd.FileSize {
		pd.FileSize = pd.FilePos
	}
	TransferredBytes = rbf_ipc.TransferredBytes
	return 0
}

// SysWrite writes count bytes from ubuf in task space to pathId
func SysWrite(pathId byte, task byte, ubuf *byte, count word) byte {
	TransferredBytes = 0
	if pathId >= MAX_PATHS || tables.Shared.PathTable[pathId].RefCount == 0 {
		return E_BPNUM
	}
	pd := &tables.Shared.PathTable[pathId]
	if (pd.Mode&MODE_WRITE) == 0 && pd.DevType != dev.DEV_TERM && pd.DevType != dev.DEV_LOG {
		return E_BMODE
	}

	if pd.DevType == dev.DEV_TERM {
		TransferredBytes = dev.TermWrite(task, word(ubuf), count)
		return 0
	}
	if pd.DevType == dev.DEV_LOG {
		TransferredBytes = dev.LogWrite(task, word(ubuf), count)
		return 0
	}
	if pd.DevType == dev.DEV_NULL {
		TransferredBytes = count
		return 0
	}

	return writeDisk(pd, task, ubuf, count)
}

// SysSeek sets the byte position of an open file
func SysSeek(pathId byte, offset word) byte {
	if pathId >= MAX_PATHS || tables.Shared.PathTable[pathId].RefCount == 0 {
		return E_BPNUM
	}
	pd := &tables.Shared.PathTable[pathId]
	if pd.DevType != dev.DEV_DISK && pd.DevType != dev.DEV_PROC {
		return E_BMODE
	}
	if pd.DevType == dev.DEV_PROC {
		if offset > pd.FileSize {
			offset = pd.FileSize
		}
	}
	pd.FilePos = offset
	return 0
}

var pathLineBuf [256]byte

// SysReadLn reads a line of text, terminating on \r or \n
func SysReadLn(pathId byte, task byte, ubuf *byte, maxLen word, lineMode byte) byte {
	TransferredBytes = 0
	if pathId >= MAX_PATHS || tables.Shared.PathTable[pathId].RefCount == 0 {
		return E_BPNUM
	}
	pd := &tables.Shared.PathTable[pathId]

	if pd.DevType == dev.DEV_TERM {
		n := dev.TermReadLn(task, word(ubuf), maxLen, lineMode)
		TransferredBytes = n
		if n == 0 {
			return E_EOF
		}
		return 0
	}

	// DEV_DISK or DEV_PROC file line read
	if maxLen <= 1 {
		return 0
	}

	limit := maxLen
	if limit > 256 {
		limit = 256
	}

	count := word(0)
	var single byte

	for count < limit-1 {
		err := SysRead(pathId, 0, &single, 1)
		if TransferredBytes == 0 || err != 0 {
			if count > 0 {
				break
			}
			return E_EOF
		}

		// Check line terminator
		if single == '\r' || single == '\n' {
			endChar := byte('\n')
			if lineMode == 1 {
				endChar = '\r'
			}
			pathLineBuf[count] = endChar
			count++
			break
		}

		pathLineBuf[count] = single
		count++
	}

	if count > 0 {
		dstAddr := word(ubuf)
		if task == 0 {
			klib.memcpy((*byte)(dstAddr), &pathLineBuf[0], count)
		} else {
			hal.DMACopy(0, word(&pathLineBuf[0]), task, dstAddr, count)
		}
	}

	TransferredBytes = count
	return 0
}

// SysWritLn writes a line from ubuf up to count bytes or until \r or \n
func SysWritLn(pathId byte, task byte, ubuf *byte, count word, lineMode byte) byte {
	TransferredBytes = 0
	if pathId >= MAX_PATHS || tables.Shared.PathTable[pathId].RefCount == 0 {
		return E_BPNUM
	}
	pd := &tables.Shared.PathTable[pathId]
	if (pd.Mode&MODE_WRITE) == 0 && pd.DevType != dev.DEV_TERM && pd.DevType != dev.DEV_LOG {
		return E_BMODE
	}

	toCopy := count
	if toCopy > 256 {
		toCopy = 256
	}

	uAddr := word(ubuf)
	if task == 0 {
		klib.memcpy(&pathLineBuf[0], (*byte)(uAddr), toCopy)
	} else {
		hal.DMACopy(task, uAddr, 0, word(&pathLineBuf[0]), toCopy)
	}

	lineLen := word(0)
	for lineLen < toCopy {
		c := pathLineBuf[lineLen]
		if c == 0 {
			break
		}
		lineLen++
		if lineMode == 1 {
			if c == '\r' {
				break
			}
		} else {
			if c == '\r' || c == '\n' {
				break
			}
		}
	}

	return SysWrite(pathId, 0, &pathLineBuf[0], lineLen)
}

