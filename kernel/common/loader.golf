package loader

import "hal"
import "klib"
import "path"

const E_FORMAT = 213 // Bad module format error

var LastLoadedIsOS9 byte
var LoadedEntryPC word
var LoadedSize word

// LoadOS9Module reads an OS-9 machine language module from open pathId
// and loads it into targetTask starting at baseAddr.
// On 6809, the module is placed high in memory so its end abuts the redpage $FF00.
// Returns errCode.
func LoadOS9Module(pathId byte, targetTask byte, baseAddr word) byte {
	var hdr [13]byte
	err := path.SysRead(pathId, 0, &hdr[0], 13)
	if path.TransferredBytes < 13 || err != 0 {
		return path.E_READ
	}

	// Verify OS-9 magic ID: $87 $CD
	if hdr[0] != 0x87 || hdr[1] != 0xCD {
		return E_FORMAT
	}

	// Header parity check: XOR of all header bytes 0..8 must equal $FF
	xorVal := byte(0)
	for i := word(0); i < 9; i++ {
		xorVal ^= hdr[i]
	}
	if xorVal != 0xFF {
		return E_FORMAT
	}

	modSize := (word(hdr[2]) << 8) | word(hdr[3])
	if modSize < 13 {
		return E_FORMAT
	}
	execOff := (word(hdr[9]) << 8) | word(hdr[10])

	loadAddr := baseAddr
	if hal.ARCH == '9' || hal.ARCH == 'z' {
		loadAddr = 0xFF00 - modSize
	}

	// Copy 13-byte header into targetTask at loadAddr
	hal.DMACopy(0, word(&hdr[0]), targetTask, loadAddr, 13)

	// Stream remainder of module into targetTask starting at loadAddr + 13
	rem := modSize - 13
	if rem > 0 {
		rerr := path.SysRead(pathId, targetTask, (*byte)(loadAddr+13), rem)
		if path.TransferredBytes != rem || rerr != 0 {
			return path.E_READ
		}
	}

	LoadedEntryPC = loadAddr + execOff
	LoadedSize = modSize
	return 0
}

var decbHdr [5]byte

// LoadDECB reads a segmented DECB binary from open pathId
// and loads its chunks directly into targetTask RAM.
// Returns errCode.
func LoadDECB(pathId byte, targetTask byte) byte {
	entryPC := word(0)
	totalLoaded := word(0)
	high16 := word(0)

	for {
		err := path.SysRead(pathId, 0, &decbHdr[0], 5)
		if path.TransferredBytes < 5 || err != 0 {
			return path.E_READ
		}

		tag := decbHdr[0]
		chunkLen := (word(decbHdr[1]) << 8) | word(decbHdr[2])
		addr := (word(decbHdr[3]) << 8) | word(decbHdr[4])

		if tag == 0 {
			// DECB_DATA chunk: load chunkLen bytes into targetTask at fullAddr
			fullAddr := addr
			if sizeof[word]() > 2 {
				fullAddr = (high16 << 16) | addr
			}
			if chunkLen > 0 {
				rerr := path.SysRead(pathId, targetTask, (*byte)(fullAddr), chunkLen)
				if path.TransferredBytes != chunkLen || rerr != 0 {
					return path.E_READ
				}
				totalLoaded += chunkLen
			}
		} else if tag == 253 {
			// Tag 253 ($FD): Hatvan Executable Magic header: 'x', <arch>
			// Byte 3 must be 'x' (executable) and Byte 4 must match hal.ARCH
			if decbHdr[3] != 'x' || decbHdr[4] != hal.ARCH {
				return E_FORMAT
			}
			if chunkLen > 0 {
				curPos := path.GetPath(pathId).FilePos
				path.SysSeek(pathId, curPos+chunkLen)
			}
		} else if tag == 254 {
			// SET_HIGH16_ADDR32 header: persistent upper 16-bit address extension (spec-hatvan-68000)
			high16 = addr
		} else if tag == 255 {
			// DECB_EXEC postamble: chunkLen is 0, addr is execution entry PC
			entryPC = addr
			if sizeof[word]() > 2 {
				entryPC = (high16 << 16) | addr
			}
			break
		} else {
			// Unrecognized or extended debug chunks (source lines, symbols): skip payload
			if chunkLen > 0 {
				curPos := path.GetPath(pathId).FilePos
				path.SysSeek(pathId, curPos+chunkLen)
			}
		}
	}

	LoadedEntryPC = entryPC
	LoadedSize = totalLoaded
	return 0
}

// LoadBinary automatically detects the binary format (OS-9 module or DECB)
// and loads it into targetTask.
// Returns errCode.
func LoadBinary(pathId byte, targetTask byte, baseAddr word) byte {
	err := path.SysRead(pathId, 0, &decbHdr[0], 5)
	if path.TransferredBytes < 2 || err != 0 {
		return path.E_READ
	}

	// Rewind file position back to 0
	path.SysSeek(pathId, 0)

	// Format 1: OS-9 module ($87 $CD) on 6809
	if hal.ARCH == '9' {
		if decbHdr[0] == 0x87 && decbHdr[1] == 0xCD {
			LastLoadedIsOS9 = 1
			return LoadOS9Module(pathId, targetTask, baseAddr)
		}
	}

	// Format 2: Tag 253 ($FD) Extended DECB with architecture validation
	if path.TransferredBytes >= 5 && decbHdr[0] == 253 {
		if decbHdr[3] == 'x' && decbHdr[4] == hal.ARCH {
			LastLoadedIsOS9 = 0
			return LoadDECB(pathId, targetTask)
		}
		// Wrong architecture or invalid magic marker
		return E_FORMAT
	}

	return E_FORMAT
}
