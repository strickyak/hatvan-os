package tables

import "hal"

const MAX_PROCS = 16
const PROC_MAX_PATHS = 16
const MAX_PATHS = 16

type Process struct {
	PID         byte
	State       byte
	ParentPID   byte
	TaskID      byte
	ExitStatus  byte
	SavedSP     word
	SavedPC     word
	SavedU      word
	Paths       [PROC_MAX_PATHS]byte
	CwdDrive    byte
	CwdFDLSN    word
	CwdPath     [64]byte
	CxdDrive    byte
	CxdFDLSN    word
	CxdPath     [64]byte
	LineMode    byte // 0 = '\n' (Unix), 1 = '\r' (OS-9)
	CodeStart   word
	CodeSize    word
	DataTop     word
	StackBottom word
	CmdName     [16]byte
}

type PathDesc struct {
	RefCount  byte
	DevType   byte
	Drive     byte
	Mode      byte
	FilePos   word
	FileSize  word
	FDLSN     word
	BufLSN    word
	BufDirty  byte
	SectorBuf [256]byte
}

// SharedTables resides at the SharedMemoryCurtain address:
// $E000 on M6809, $00FE0000 on M68000.
// Tasks 0, 1, and 2 all share this memory region.
type SharedTables struct {
	CurrentPID    byte
	Pad           byte
	RBFMailbox    [64]byte
	ProcfsMailbox [64]byte
	ProcTable     [MAX_PROCS]Process
	PathTable     [MAX_PATHS]PathDesc
}

var Shared *SharedTables
var Size word

func Init() {
	Size = sizeof[SharedTables]()
	Shared = (*SharedTables)(hal.SHARED_MEM_CURTAIN)

	vmCurtain := hal.GetSharedCurtain()
	if vmCurtain != 0 && vmCurtain != hal.SHARED_MEM_CURTAIN {
		panic("Shared memory curtain mismatch between kernel and VM")
	}

	if hal.ARCH == '9' {
		if Size > (0xFF00 - hal.SHARED_MEM_CURTAIN) {
			panic("SharedTables exceeds shared memory curtain on M6809")
		}
	} else {
		if Size > (0x00FF0000 - hal.SHARED_MEM_CURTAIN) {
			panic("SharedTables exceeds shared memory curtain on M68k")
		}
	}
}
