package rbf

import "hal"
import "klib"

const RBF_SECTOR_SIZE = 256
const RBF_DIR_ENTRY_SIZE = 32
const RBF_MAX_SEGMENTS = 16

// Static sector buffers for RBF operations (Task 1 RAM)
var rbfSectorBuf [256]byte
var rbfDirBuf [256]byte
var rbfMapBuf [256]byte

// RBFSuperblock represents LSN 0 metadata
type RBFSuperblock struct {
	TotalSectors word
	TrackSize    byte
	MapBytes     word
	ClusterSize  word
	RootDirLSN   word
	Attributes   byte
	DiskID       word
}

// RBFSegment represents one contiguous segment of disk blocks
type RBFSegment struct {
	LSN   word
	Count word
}

// RBFFileDescriptor represents decoded metadata from an FD sector
type RBFFileDescriptor struct {
	Attributes byte
	FileSize   word
	SegCount   byte
	Segments   [RBF_MAX_SEGMENTS]RBFSegment
}

// readWord16 reads a big-endian 16-bit word from memory address addr
func readWord16(addr word) word {
	hi := word(peekb(addr))
	lo := word(peekb(addr + 1))
	return (hi << 8) | lo
}

// readWord24 reads a big-endian 24-bit LSN from memory address addr
func readWord24(addr word) word {
	b0 := word(peekb(addr))
	b1 := word(peekb(addr + 1))
	b2 := word(peekb(addr + 2))
	res := (b1 << 8) | b2
	if sizeof[word]() > 2 {
		res = (b0 << 16) | res
	}
	return res
}

// readWord32 reads a big-endian 32-bit word from memory address addr
func readWord32(addr word) word {
	b0 := word(peekb(addr))
	b1 := word(peekb(addr + 1))
	b2 := word(peekb(addr + 2))
	b3 := word(peekb(addr + 3))
	res := (b2 << 8) | b3
	if sizeof[word]() > 2 {
		res = (b0 << 24) | (b1 << 16) | res
	}
	return res
}

// toUpper converts an ASCII character to uppercase
func toUpper(c byte) byte {
	if c >= 'a' && c <= 'z' {
		return c - 32
	}
	return c
}

// RBFReadSector reads sector lsn of drive into destination buffer dst
func RBFReadSector(drive byte, lsn word, dst *byte) byte {
	return hal.DiskTransfer(drive, lsn, 1, word(dst), 0)
}

// RBFGetFDInf reads fdLSN sector and copies count bytes into task memory at dstAddr
func RBFGetFDInf(drive byte, fdLSN word, task byte, dstAddr word, count word) byte {
	bufAddr := word(&rbfSectorBuf[0])
	st := hal.DiskTransfer(drive, fdLSN, 1, bufAddr, 0)
	if st != 1 {
		return 244 // E_READ
	}
	if task == 1 {
		klib.memcpy((*byte)(dstAddr), (*byte)(bufAddr), count)
	} else {
		hal.DMACopy(1, bufAddr, task, dstAddr, count)
	}
	return 0
}

// RBFWriteSector writes sector lsn of drive from source buffer src
func RBFWriteSector(drive byte, lsn word, src *byte) byte {
	return hal.DiskTransfer(drive, lsn, 1, word(src), 1)
}

// RBFReadSuperblock reads and parses the LSN 0 Identification Sector
func RBFReadSuperblock(drive byte, sb *RBFSuperblock) byte {
	bufAddr := word(&rbfSectorBuf[0])
	st := hal.DiskTransfer(drive, 0, 1, bufAddr, 0)
	if st != 1 {
		return st
	}

	sb.TotalSectors = readWord24(bufAddr)
	sb.TrackSize = peekb(bufAddr + 3)
	sb.MapBytes = readWord16(bufAddr + 4)
	sb.ClusterSize = readWord16(bufAddr + 6)
	sb.RootDirLSN = readWord24(bufAddr + 8)
	sb.Attributes = peekb(bufAddr + 14)
	sb.DiskID = readWord16(bufAddr + 15)
	return 1
}

// RBFReadFD reads and decodes the File Descriptor sector at fdLSN
func RBFReadFD(drive byte, fdLSN word, fd *RBFFileDescriptor) byte {
	bufAddr := word(&rbfSectorBuf[0])
	st := hal.DiskTransfer(drive, fdLSN, 1, bufAddr, 0)
	if st != 1 {
		return st
	}

	fd.Attributes = peekb(bufAddr)
	fd.FileSize = readWord32(bufAddr + 9)
	fd.SegCount = 0

	segAddr := bufAddr + 16
	for i := word(0); i < RBF_MAX_SEGMENTS; i++ {
		cnt := readWord16(segAddr + 3)
		if cnt == 0 {
			break
		}
		fd.Segments[i].LSN = readWord24(segAddr)
		fd.Segments[i].Count = cnt
		fd.SegCount++
		segAddr += 5
	}
	return 1
}

// RBFWriteFD writes updated File Descriptor metadata to fdLSN
func RBFWriteFD(drive byte, fdLSN word, fd *RBFFileDescriptor) byte {
	bufAddr := word(&rbfSectorBuf[0])
	// Read existing FD sector to preserve header fields (owner, dates, etc.)
	st := hal.DiskTransfer(drive, fdLSN, 1, bufAddr, 0)
	if st != 1 {
		for i := word(0); i < 256; i++ {
			pokeb(bufAddr+i, 0)
		}
		pokeb(bufAddr+8, 1) // Link count = 1
	}

	pokeb(bufAddr, fd.Attributes)
	pokeb(bufAddr+9, byte(fd.FileSize>>24))
	pokeb(bufAddr+10, byte(fd.FileSize>>16))
	pokeb(bufAddr+11, byte(fd.FileSize>>8))
	pokeb(bufAddr+12, byte(fd.FileSize))

	segAddr := bufAddr + 16
	for i := word(0); i < RBF_MAX_SEGMENTS; i++ {
		if i < word(fd.SegCount) {
			lsn := fd.Segments[i].LSN
			cnt := fd.Segments[i].Count
			pokeb(segAddr, byte(lsn>>16))
			pokeb(segAddr+1, byte(lsn>>8))
			pokeb(segAddr+2, byte(lsn))
			pokeb(segAddr+3, byte(cnt>>8))
			pokeb(segAddr+4, byte(cnt))
		} else {
			pokeb(segAddr, 0)
			pokeb(segAddr+1, 0)
			pokeb(segAddr+2, 0)
			pokeb(segAddr+3, 0)
			pokeb(segAddr+4, 0)
		}
		segAddr += 5
	}

	return hal.DiskTransfer(drive, fdLSN, 1, bufAddr, 1)
}

// RBFLogicalToPhys maps a logical file sector index to its physical disk LSN
func RBFLogicalToPhys(fd *RBFFileDescriptor, logSec word) word {
	rem := logSec
	for i := word(0); i < word(fd.SegCount); i++ {
		cnt := fd.Segments[i].Count
		if rem < cnt {
			return fd.Segments[i].LSN + rem
		}
		rem -= cnt
	}
	return 0
}

// RBFMatchName checks if a 29-byte high-bit-terminated entry name matches targetName
func RBFMatchName(entryAddr word, targetName *byte) bool {
	tAddr := word(targetName)
	for i := word(0); i < 29; i++ {
		ec := peekb(entryAddr + i)
		isLast := (ec & 0x80) != 0
		rawChar := ec & 0x7F
		tc := peekb(tAddr)

		if tc == 0 {
			return false
		}
		if toUpper(rawChar) != toUpper(tc) {
			return false
		}

		tAddr++
		if isLast {
			return peekb(tAddr) == 0
		}
	}
	return false
}

// RBFScanDirectory searches a directory FD for targetName, returning its FD LSN or 0
func RBFScanDirectory(drive byte, dirFD *RBFFileDescriptor, targetName *byte) word {
	if (dirFD.Attributes & 0x80) == 0 {
		return 0 // Not a directory
	}

	totalSectors := (dirFD.FileSize + 255) / 256
	dirBufAddr := word(&rbfDirBuf[0])

	for s := word(0); s < totalSectors; s++ {
		physLSN := RBFLogicalToPhys(dirFD, s)
		if physLSN == 0 {
			break
		}

		st := hal.DiskTransfer(drive, physLSN, 1, dirBufAddr, 0)
		if st != 1 {
			break
		}

		for e := word(0); e < 8; e++ {
			entryOffset := s*256 + e*32
			if entryOffset >= dirFD.FileSize {
				return 0
			}

			entryAddr := dirBufAddr + e*32
			if peekb(entryAddr) == 0 {
				continue // Deleted or empty slot
			}

			if RBFMatchName(entryAddr, targetName) {
				return readWord24(entryAddr + 29)
			}
		}
	}
	return 0
}

// RBFFormatDirEntry formats a 32-byte directory entry with high-bit on last char of name
func RBFFormatDirEntry(entryAddr word, name *byte, fdLSN word) {
	for i := word(0); i < 32; i++ {
		pokeb(entryAddr+i, 0)
	}
	p := word(name)
	nameLen := word(0)
	for nameLen < 29 {
		c := peekb(p + nameLen)
		if c == 0 || c == '/' || c == ' ' || c == '\r' || c == '\n' {
			break
		}
		nameLen++
	}
	if nameLen == 0 {
		return
	}
	for i := word(0); i < nameLen; i++ {
		c := peekb(p + i)
		if i == nameLen-1 {
			c |= 0x80
		}
		pokeb(entryAddr+i, c)
	}
	pokeb(entryAddr+29, byte(fdLSN>>16))
	pokeb(entryAddr+30, byte(fdLSN>>8))
	pokeb(entryAddr+31, byte(fdLSN))
}

// RBFAllocClusters finds up to count contiguous free clusters in the allocation bitmap
func RBFAllocClusters(drive byte, count word) (word, word) {
	var sb RBFSuperblock
	st := RBFReadSuperblock(drive, &sb)
	if st != 1 {
		return 0, 0
	}

	totalClusters := sb.TotalSectors / sb.ClusterSize
	mapSecCount := (sb.MapBytes + 255) / 256
	mapBufAddr := word(&rbfMapBuf[0])

	for s := word(0); s < mapSecCount; s++ {
		mapLSN := word(1) + s
		st = hal.DiskTransfer(drive, mapLSN, 1, mapBufAddr, 0)
		if st != 1 {
			return 0, 0
		}

		for b := word(0); b < 256; b++ {
			byteIdx := s*256 + b
			if byteIdx >= sb.MapBytes {
				break
			}
			val := peekb(mapBufAddr + b)
			if val != 0xFF {
				for bit := word(0); bit < 8; bit++ {
					mask := byte(1 << (7 - bit))
					if (val & mask) == 0 {
						clusterNum := byteIdx*8 + bit
						if clusterNum >= totalClusters {
							return 0, 0
						}

						// Found start of free cluster run
						allocCnt := word(0)
						curByte := b
						curBit := bit
						for allocCnt < count {
							if (s*256 + curByte) >= sb.MapBytes {
								break
							}
							bVal := peekb(mapBufAddr + curByte)
							bMask := byte(1 << (7 - curBit))
							if (bVal & bMask) != 0 {
								break // cluster is used
							}
							pokeb(mapBufAddr+curByte, bVal|bMask)
							allocCnt++
							curBit++
							if curBit == 8 {
								curBit = 0
								curByte++
								if curByte >= 256 {
									break // don't span across map sectors in single write
								}
							}
						}

						st = hal.DiskTransfer(drive, mapLSN, 1, mapBufAddr, 1)
						if st != 1 {
							return 0, 0
						}

						startLSN := clusterNum * sb.ClusterSize
						return startLSN, allocCnt
					}
				}
			}
		}
	}
	return 0, 0 // Disk full
}

// RBFFreeClusters marks count clusters starting at lsn as free in the bitmap
func RBFFreeClusters(drive byte, lsn word, count word) {
	var sb RBFSuperblock
	st := RBFReadSuperblock(drive, &sb)
	if st != 1 {
		return
	}

	mapBufAddr := word(&rbfMapBuf[0])
	curMapLSN := word(0xFFFF)

	for c := word(0); c < count; c++ {
		clusterNum := (lsn / sb.ClusterSize) + c
		byteIdx := clusterNum / 8
		bit := clusterNum % 8
		mapLSN := word(1) + (byteIdx / 256)
		secOff := byteIdx % 256

		if mapLSN != curMapLSN {
			if curMapLSN != 0xFFFF {
				hal.DiskTransfer(drive, curMapLSN, 1, mapBufAddr, 1)
			}
			st = hal.DiskTransfer(drive, mapLSN, 1, mapBufAddr, 0)
			if st != 1 {
				return
			}
			curMapLSN = mapLSN
		}

		mask := byte(1 << (7 - bit))
		val := peekb(mapBufAddr + secOff)
		pokeb(mapBufAddr+secOff, val&^mask)
	}

	if curMapLSN != 0xFFFF {
		hal.DiskTransfer(drive, curMapLSN, 1, mapBufAddr, 1)
	}
}

// RBFAddDirEntry adds entry (name, fdLSN) to directory dirFD
func RBFAddDirEntry(drive byte, dirFDLSN word, dirFD *RBFFileDescriptor, name *byte, fdLSN word) byte {
	dirBufAddr := word(&rbfDirBuf[0])
	totalSectors := (dirFD.FileSize + 255) / 256

	// 1. Search for an existing deleted slot (byte 0 == 0) within current FileSize
	for s := word(0); s < totalSectors; s++ {
		physLSN := RBFLogicalToPhys(dirFD, s)
		if physLSN == 0 {
			break
		}
		st := hal.DiskTransfer(drive, physLSN, 1, dirBufAddr, 0)
		if st != 1 {
			return 244 // E_READ
		}

		for e := word(0); e < 8; e++ {
			entryOffset := s*256 + e*32
			if entryOffset >= dirFD.FileSize {
				break
			}
			entryAddr := dirBufAddr + e*32
			if peekb(entryAddr) == 0 {
				// Found empty slot!
				RBFFormatDirEntry(entryAddr, name, fdLSN)
				st = hal.DiskTransfer(drive, physLSN, 1, dirBufAddr, 1)
				if st != 1 {
					return 245 // E_WRITE
				}
				return 0
			}
		}
	}

	// 2. No deleted slots found: append to directory
	newOffset := dirFD.FileSize
	secIdx := newOffset / 256
	secOff := newOffset % 256

	if secOff > 0 {
		// Existing last sector has room
		physLSN := RBFLogicalToPhys(dirFD, secIdx)
		st := hal.DiskTransfer(drive, physLSN, 1, dirBufAddr, 0)
		if st != 1 {
			return 244
		}
		RBFFormatDirEntry(dirBufAddr+secOff, name, fdLSN)
		st = hal.DiskTransfer(drive, physLSN, 1, dirBufAddr, 1)
		if st != 1 {
			return 245 // E_WRITE
		}
	} else {
		// Need new sector for directory
		newLSN, newCnt := RBFAllocClusters(drive, 1)
		if newCnt == 0 {
			return 246 // E_DFULL
		}
		for i := word(0); i < 256; i++ {
			pokeb(dirBufAddr+i, 0)
		}
		RBFFormatDirEntry(dirBufAddr, name, fdLSN)
		st := hal.DiskTransfer(drive, newLSN, 1, dirBufAddr, 1)
		if st != 1 {
			RBFFreeClusters(drive, newLSN, 1)
			return 245
		}

		lastIdx := word(dirFD.SegCount) - 1
		if dirFD.SegCount > 0 && dirFD.Segments[lastIdx].LSN+dirFD.Segments[lastIdx].Count == newLSN {
			dirFD.Segments[lastIdx].Count += 1
		} else {
			if dirFD.SegCount >= RBF_MAX_SEGMENTS {
				RBFFreeClusters(drive, newLSN, 1)
				return 246
			}
			dirFD.Segments[dirFD.SegCount].LSN = newLSN
			dirFD.Segments[dirFD.SegCount].Count = 1
			dirFD.SegCount++
		}
	}

	dirFD.FileSize += 32
	st := RBFWriteFD(drive, dirFDLSN, dirFD)
	if st != 1 {
		return 245
	}
	return 0
}

// ParsePathDrive extracts optional "/d0".."/d3" prefix from path.
// Returns (driveIndex, remainingPathPtr). If no drive prefix, driveIndex is 0xFF.
func ParsePathDrive(path *byte) (byte, *byte) {
	p := word(path)
	if peekb(p) == '/' && peekb(p+1) == 'd' {
		d := peekb(p + 2)
		if d >= '0' && d <= '3' {
			return d - '0', (*byte)(p + 3)
		}
	}
	return 0xFF, path
}

// RBFResolvePath resolves a full or relative path string to a (drive, fdLSN).
// Returns (drive, fdLSN). If resolution fails, returns (0xFF, 0).
func RBFResolvePath(path *byte, defaultDrive byte, cwdLSN word, cxdLSN word, isExec byte) (byte, word) {
	drive, remPath := ParsePathDrive(path)
	isAbs := false
	if drive != 0xFF {
		isAbs = true
	} else {
		drive = defaultDrive
	}

	p := word(remPath)
	if peekb(p) == '/' {
		isAbs = true
	}

	currFDLSN := word(0)

	// If absolute path starting with '/' or drive prefix
	if isAbs {
		var sb RBFSuperblock
		st := RBFReadSuperblock(drive, &sb)
		if st != 1 {
			return 0xFF, 0
		}
		currFDLSN = sb.RootDirLSN
		for peekb(p) == '/' {
			p++
		}
	} else {
		// Relative path
		if isExec != 0 {
			currFDLSN = cxdLSN
		} else {
			currFDLSN = cwdLSN
		}
	}

	var compBuf [32]byte
	var dirFD RBFFileDescriptor

	for {
		c := peekb(p)
		if c == 0 || c == '\r' || c == '\n' || c == ' ' {
			break
		}

		// Extract component
		idx := word(0)
		for idx < 29 {
			ch := peekb(p)
			if ch == 0 || ch == '/' || ch == '\r' || ch == '\n' || ch == ' ' {
				break
			}
			compBuf[idx] = ch
			idx++
			p++
		}
		compBuf[idx] = 0

		if peekb(p) == '/' {
			p++
		}

		if idx > 0 {
			st := RBFReadFD(drive, currFDLSN, &dirFD)
			if st != 1 {
				return 0xFF, 0
			}

			nextLSN := RBFScanDirectory(drive, &dirFD, &compBuf[0])
			if nextLSN == 0 {
				return 0xFF, 0
			}
			currFDLSN = nextLSN
		}
	}

	return drive, currFDLSN
}

// RBFResolveParent splits path into (drive, parentDirFDLSN, fileNamePtr).
func RBFResolveParent(path *byte, defaultDrive byte, cwdLSN word) (byte, word, *byte) {
	drive, remPath := ParsePathDrive(path)
	if drive == 0xFF {
		drive = defaultDrive
	}

	p := word(remPath)
	lastSlash := word(0)
	hasSlash := false
	idx := word(0)
	for {
		c := peekb(p + idx)
		if c == 0 || c == ' ' || c == '\r' || c == '\n' {
			break
		}
		if c == '/' {
			hasSlash = true
			lastSlash = p + idx
		}
		idx++
	}

	if !hasSlash {
		curDirLSN := cwdLSN
		if curDirLSN == 0 {
			var sb RBFSuperblock
			st := RBFReadSuperblock(drive, &sb)
			if st == 1 {
				curDirLSN = sb.RootDirLSN
			}
		}
		return drive, curDirLSN, remPath
	}

	if lastSlash == p {
		var sb RBFSuperblock
		st := RBFReadSuperblock(drive, &sb)
		if st != 1 {
			return 0xFF, 0, remPath
		}
		return drive, sb.RootDirLSN, (*byte)(lastSlash + 1)
	}

	pokeb(lastSlash, 0)
	pDrive, parentFDLSN := RBFResolvePath(path, defaultDrive, cwdLSN, 0, 0)
	pokeb(lastSlash, '/')
	return pDrive, parentFDLSN, (*byte)(lastSlash + 1)
}

// RBFCreateFile creates or truncates a file in parent directory parentDirFDLSN
func RBFCreateFile(drive byte, parentDirFDLSN word, fileName *byte, attr byte) (word, byte) {
	var dirFD RBFFileDescriptor
	st := RBFReadFD(drive, parentDirFDLSN, &dirFD)
	if st != 1 {
		return 0, 216 // E_PNNF
	}

	existingFDLSN := RBFScanDirectory(drive, &dirFD, fileName)
	if existingFDLSN != 0 {
		var existFD RBFFileDescriptor
		st = RBFReadFD(drive, existingFDLSN, &existFD)
		if st == 1 {
			for i := word(0); i < word(existFD.SegCount); i++ {
				RBFFreeClusters(drive, existFD.Segments[i].LSN, existFD.Segments[i].Count)
			}
			existFD.FileSize = 0
			existFD.SegCount = 0
			RBFWriteFD(drive, existingFDLSN, &existFD)
			return existingFDLSN, 0
		}
	}

	newFDLSN, cnt := RBFAllocClusters(drive, 1)
	if cnt == 0 {
		return 0, 246 // E_DFULL
	}

	var newFD RBFFileDescriptor
	newFD.Attributes = attr | 0x03 // read/write
	newFD.FileSize = 0
	newFD.SegCount = 0
	st = RBFWriteFD(drive, newFDLSN, &newFD)
	if st != 1 {
		RBFFreeClusters(drive, newFDLSN, 1)
		return 0, 245 // E_WRITE
	}

	err := RBFAddDirEntry(drive, parentDirFDLSN, &dirFD, fileName, newFDLSN)
	if err != 0 {
		RBFFreeClusters(drive, newFDLSN, 1)
		return 0, err
	}

	return newFDLSN, 0
}

// RBFWriteFile writes count bytes from srcTask at srcAddr to file fdLSN at filePos
func RBFWriteFile(drive byte, fdLSN word, filePos word, srcTask byte, srcAddr word, count word) (word, word, byte) {
	if count == 0 {
		return 0, 0, 0
	}

	var fd RBFFileDescriptor
	st := RBFReadFD(drive, fdLSN, &fd)
	if st != 1 {
		return 0, 0, 244 // E_READ
	}

	allocSectors := word(0)
	for i := word(0); i < word(fd.SegCount); i++ {
		allocSectors += fd.Segments[i].Count
	}

	newEnd := filePos + count
	neededSectors := (newEnd + 255) / 256

	for allocSectors < neededSectors {
		diff := neededSectors - allocSectors
		newLSN, newCnt := RBFAllocClusters(drive, diff)
		if newCnt == 0 {
			return 0, fd.FileSize, 246 // E_DFULL
		}

		lastIdx := word(fd.SegCount) - 1
		if fd.SegCount > 0 && fd.Segments[lastIdx].LSN+fd.Segments[lastIdx].Count == newLSN {
			fd.Segments[lastIdx].Count += newCnt
		} else {
			if fd.SegCount >= RBF_MAX_SEGMENTS {
				RBFFreeClusters(drive, newLSN, newCnt)
				return 0, fd.FileSize, 246
			}
			fd.Segments[fd.SegCount].LSN = newLSN
			fd.Segments[fd.SegCount].Count = newCnt
			fd.SegCount++
		}
		allocSectors += newCnt
	}

	bytesDone := word(0)
	curPos := filePos

	for bytesDone < count {
		logSec := curPos / 256
		secOff := curPos % 256
		physLSN := RBFLogicalToPhys(&fd, logSec)
		if physLSN == 0 {
			break
		}

		chunk := 256 - secOff
		rem := count - bytesDone
		if chunk > rem {
			chunk = rem
		}

		if secOff == 0 && chunk == 256 {
			st = hal.DiskTransfer(drive, physLSN, srcTask, srcAddr+bytesDone, 1)
			if st != 1 {
				break
			}
		} else {
			if curPos < fd.FileSize || secOff > 0 {
				st = hal.DiskTransfer(drive, physLSN, 1, word(&rbfSectorBuf[0]), 0)
				if st != 1 {
					break
				}
			} else {
				for k := word(0); k < 256; k++ {
					rbfSectorBuf[k] = 0
				}
			}

			if srcTask == 1 {
				klib.memcpy((*byte)(word(&rbfSectorBuf[0])+secOff), (*byte)(srcAddr+bytesDone), chunk)
			} else {
				hal.DMACopy(srcTask, srcAddr+bytesDone, 1, word(&rbfSectorBuf[0])+secOff, chunk)
			}

			st = hal.DiskTransfer(drive, physLSN, 1, word(&rbfSectorBuf[0]), 1)
			if st != 1 {
				break
			}
		}

		bytesDone += chunk
		curPos += chunk
	}

	if curPos > fd.FileSize {
		fd.FileSize = curPos
	}

	st = RBFWriteFD(drive, fdLSN, &fd)
	if st != 1 {
		return bytesDone, fd.FileSize, 245 // E_WRITE
	}

	return bytesDone, fd.FileSize, 0
}

// RBFDeleteFile deletes fileName from directory parentDirFDLSN
func RBFDeleteFile(drive byte, parentDirFDLSN word, fileName *byte) byte {
	var dirFD RBFFileDescriptor
	st := RBFReadFD(drive, parentDirFDLSN, &dirFD)
	if st != 1 {
		return 216 // E_PNNF
	}

	totalSectors := (dirFD.FileSize + 255) / 256
	dirBufAddr := word(&rbfDirBuf[0])

	for s := word(0); s < totalSectors; s++ {
		physLSN := RBFLogicalToPhys(&dirFD, s)
		if physLSN == 0 {
			break
		}
		st = hal.DiskTransfer(drive, physLSN, 1, dirBufAddr, 0)
		if st != 1 {
			return 244
		}

		for e := word(0); e < 8; e++ {
			entryOffset := s*256 + e*32
			if entryOffset >= dirFD.FileSize {
				return 216
			}
			entryAddr := dirBufAddr + e*32
			if peekb(entryAddr) == 0 {
				continue
			}

			if RBFMatchName(entryAddr, fileName) {
				fdLSN := readWord24(entryAddr + 29)

				var fileFD RBFFileDescriptor
				st = RBFReadFD(drive, fdLSN, &fileFD)
				if st == 1 {
					for i := word(0); i < word(fileFD.SegCount); i++ {
						RBFFreeClusters(drive, fileFD.Segments[i].LSN, fileFD.Segments[i].Count)
					}
				}
				RBFFreeClusters(drive, fdLSN, 1)

				pokeb(entryAddr, 0)
				st = hal.DiskTransfer(drive, physLSN, 1, dirBufAddr, 1)
				if st != 1 {
					return 245 // E_WRITE
				}
				return 0
			}
		}
	}
	return 216 // E_PNNF
}
