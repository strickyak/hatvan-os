package main

import "hal"
import "klib"
import "rbf"
import "dev"
import "path"
import "proc"
import "syscall"
import "sh"

var bootSB rbf.RBFSuperblock

func main() {
	dev.KLog((*byte)("Hatvan OS"))

	// Initialize path subsystem
	path.PathInit()
	syscall.SyscallInit()

	// 1. Test opening and writing to /term
	termPath := (*byte)("/term")
	pTerm, err := path.SysOpen(0, termPath, path.MODE_WRITE, 0, 0, 0)
	if err == 0 {
		dev.KLog((*byte)("PATH:TERM:OK"))
	}

	// 2. Test opening and reading /d0/Cmds9 (6809) or /d0/CmdsK (68k) directory
	cmdsPath := (*byte)("/d0/Cmds9")
	if hal.ARCH == 'k' {
		cmdsPath = (*byte)("/d0/CmdsK")
	}
	pDir, err := path.SysOpen(0, cmdsPath, path.MODE_READ|path.MODE_DIR, 0, 0, 0)
	if err == 0 {
		dev.KLog((*byte)("PATH:CMDS:OK"))

		// Read first 32-byte directory entry from CMDS
		var dirEntry [32]byte
		n, rerr := path.SysRead(pDir, 0, &dirEntry[0], 32)
		if n == 32 && rerr == 0 {
			dev.KLog((*byte)("DIR:ENTRY:OK"))
		}

		path.SysClose(pDir)
	}

	// 3. Test SysCreate on /log device
	logPath := (*byte)("/log")
	pLog, errLog := path.SysCreate(0, logPath, path.MODE_WRITE, 0, 0, 0)
	if errLog == 0 {
		dev.KLog((*byte)("PATH:LOG:OK"))
		path.SysClose(pLog)
	}

	if pTerm != 0xFF {
		path.SysClose(pTerm)
	}

	// 4. Test Process Management & 4 Standard Paths Inheritance (Phase 4)
	proc.ProcInit()

	// Allocate root Process 1 (e.g. Shell)
	p1PID, p1 := proc.ProcAlloc(0)
	if p1PID == 1 && p1 != (*proc.Process)(0) {
		klib.strcpy(&p1.CmdName[0], (*byte)("sh"))
		// Open 4 standard paths for Process 1:
		// 0: stdin (/term)
		// 1: stdout (/term)
		// 2: stderr (/term)
		// 3: stdlog (/log)
		pIn, _ := proc.ProcOpen(1, termPath, path.MODE_READ)
		pOut, _ := proc.ProcOpen(1, termPath, path.MODE_WRITE)
		pErr, _ := proc.ProcOpen(1, termPath, path.MODE_WRITE)
		pLogProc, _ := proc.ProcOpen(1, logPath, path.MODE_WRITE)

		if pIn == 0 && pOut == 1 && pErr == 2 && pLogProc == 3 {
			// Now fork/allocate child Process 2 from parent Process 1
			p2PID, p2 := proc.ProcAlloc(1)
			if p2PID == 2 && p2 != (*proc.Process)(0) {
				// Verify child inherited all 4 standard paths
				if p2.Paths[0] == p1.Paths[0] && p2.Paths[1] == p1.Paths[1] && p2.Paths[2] == p1.Paths[2] && p2.Paths[3] == p1.Paths[3] {
					dev.KLog((*byte)("PROC:INHERIT4:OK"))
				}

				// Free child process
				proc.ProcFree(2)
			}

			// 5. Test SysFork with OS-9 Module (/d0/Cmds9/TESTCMD)
			proc.SetCurrentPID(1)
			os9Cmd := (*byte)("/d0/Cmds9/TESTCMD")
			paramStr := (*byte)("testarg")
			c1PID, c1Err := proc.SysFork(os9Cmd, paramStr, 7)
			if c1Err == 0 && c1PID > 0 {
				var checkMagic [2]byte
				hal.DMACopy(c1PID, proc.ProcTable[c1PID].CodeStart, 0, word(&checkMagic[0]), 2)
				if checkMagic[0] == 0x87 && checkMagic[1] == 0xCD {
					dev.KLog((*byte)("FORK:OS9:OK"))
				}
			}

			// 6. Test SysFork with DECB Binary (/d0/Cmds9/TESTDECB)
			decbCmd := (*byte)("/d0/Cmds9/TESTDECB")
			c2PID, c2Err := proc.SysFork(decbCmd, (*byte)(0), 0)
			if c2Err == 0 && c2PID > 0 {
				var checkDECB [2]byte
				hal.DMACopy(c2PID, 0x0500, 0, word(&checkDECB[0]), 2)
				if checkDECB[0] == 0x86 && proc.ProcTable[c2PID].SavedPC == 0x0500 {
					dev.KLog((*byte)("FORK:DECB:OK"))
				}
			}

			// 7. Test SysChgDir & cxd relative binary execution
			cxdPath := (*byte)("/d0/Cmds9")
			if hal.ARCH == 'k' {
				cxdPath = (*byte)("/d0/CmdsK")
			}
			stCxd := proc.SysChgDir(cxdPath, path.MODE_EXEC)
			if stCxd == 0 {
				relCmd := (*byte)("ECHO")
				c3PID, c3Err := proc.SysFork(relCmd, (*byte)(0), 0)
				if c3Err == 0 && c3PID > 0 {
					dev.KLog((*byte)("FORK:CXD:OK"))
					proc.ProcFree(c3PID)
				}
			}

			// 8. Test SysWait & process termination
			if c1PID > 0 {
				proc.ProcTable[c1PID].ExitStatus = 42
				proc.ProcTable[c1PID].State = proc.PROC_ZOMBIE
				wpid, wst, werr := proc.SysWait()
				if wpid == c1PID && wst == 42 && werr == 0 {
					dev.KLog((*byte)("WAIT:OK"))
				}
			}

			if c2PID > 0 {
				proc.ProcFree(c2PID)
			}

			// 9. Test User Process Execution in User Space (Phase 5)
			proc.SetCurrentPID(1)
			echoCmd := (*byte)("ECHO")
			paramEcho := (*byte)("hello world\r")
			pEcho, pEchoErr := proc.SysFork(echoCmd, paramEcho, 12)
			if pEchoErr == 0 && pEcho > 0 {
				dev.KLog((*byte)("USER:EXEC:START"))

				hal.LaunchProcess(pEcho, proc.ProcTable[pEcho].SavedSP, proc.ProcTable[pEcho].SavedPC)

				// After child exits, SysWait reaps it
				wpid, wst, werr := proc.SysWait()
				if wpid == pEcho && wst == 0 && werr == 0 {
					dev.KLog((*byte)("USER:ECHO:OK"))
				}
			}

			// Free parent process
			proc.ProcFree(1)
			dev.KLog((*byte)("PROC:LIFECYCLE:OK"))
		}
	}

	// 10. Resident Mini-Shell (Phase 5)
	pShellPID, pShell := proc.ProcAlloc(0)
	if pShellPID == 1 && pShell != (*proc.Process)(0) {
		klib.strcpy(&pShell.CmdName[0], (*byte)("sh"))
		proc.ProcOpen(1, termPath, path.MODE_READ)
		proc.ProcOpen(1, termPath, path.MODE_WRITE)
		proc.ProcOpen(1, termPath, path.MODE_WRITE)
		proc.ProcOpen(1, logPath, path.MODE_WRITE)
		proc.SetCurrentPID(1)

		// Initialize shell cwd to /d0 and cxd to /d0/Cmds9 or /d0/CmdsK
		proc.SysChgDir((*byte)("/d0"), 0)
		if hal.ARCH == 'k' {
			proc.SysChgDir((*byte)("/d0/CmdsK"), path.MODE_EXEC)
		} else {
			proc.SysChgDir((*byte)("/d0/Cmds9"), path.MODE_EXEC)
		}

		// Test /proc/p file system (read and readln)
		procPath := (*byte)("/proc/p")
		pProc, pProcErr := proc.ProcOpen(1, procPath, path.MODE_READ)
		if pProcErr == 0 && pProc != 0xFF {
			var pBuf [256]byte
			rn, rerr := proc.ProcRead(1, pProc, &pBuf[0], 255)
			if rerr == 0 && rn > 0 {
				dev.KLog((*byte)("PROCFS:READ:OK"))
			}
			proc.ProcClose(1, pProc)
		}

		pProcLn, pProcLnErr := proc.ProcOpen(1, procPath, path.MODE_READ)
		if pProcLnErr == 0 && pProcLn != 0xFF {
			var lnBuf [64]byte
			ln, lnErr := proc.ProcReadLn(1, pProcLn, &lnBuf[0], 64)
			if lnErr == 0 && ln > 0 {
				dev.KLog((*byte)("PROCFS:READLN:OK"))
			}
			proc.ProcClose(1, pProcLn)
		}

		// Test invalid /proc subpath returns E_PNNF
		pBad, pBadErr := proc.ProcOpen(1, (*byte)("/proc/nonexistent"), path.MODE_READ)
		if pBadErr == path.E_PNNF && pBad == 0xFF {
			dev.KLog((*byte)("PROCFS:BADPATH:OK"))
		}

		// Test builtin command execution
		shSt := sh.RunCommand((*byte)("help"))
		if shSt == 0 {
			dev.KLog((*byte)("SHELL:HELP:OK"))
		}

		// Test external binary execution through shell
		shEcho := (*byte)("ECHO hello from shell")
		shEchoSt := sh.RunCommand(shEcho)
		if shEchoSt == 0 {
			dev.KLog((*byte)("SHELL:EXEC:OK"))
		}

		// Enter resident shell loop
		sh.RunShell()
	}

	hal.Exit(0)
}
