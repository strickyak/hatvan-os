package main

import "hal"
import "klib"
import "rbf"
import "dev"
import "path"

var bootSB rbf.RBFSuperblock

func main() {
	hal.PutChar('H')
	hal.PutChar('a')
	hal.PutChar('t')
	hal.PutChar('v')
	hal.PutChar('a')
	hal.PutChar('n')
	hal.PutChar(' ')
	hal.PutChar('O')
	hal.PutChar('S')
	hal.PutChar('\n')

	// Initialize path subsystem
	path.PathInit()

	// 1. Test opening and writing to /term
	termPath := (*byte)("/term")
	pTerm, err := path.SysOpen(0, termPath, path.MODE_WRITE, 0, 0, 0)
	if err == 0 {
		msg := (*byte)("PATH:TERM:OK")
		path.SysWritLn(pTerm, 0, msg, 12, 0)
	}

	// 2. Test opening and reading /d0/CMDS directory
	cmdsPath := (*byte)("/d0/CMDS")
	pDir, err := path.SysOpen(0, cmdsPath, path.MODE_READ | path.MODE_DIR, 0, 0, 0)
	if err == 0 {
		msg := (*byte)("PATH:CMDS:OK")
		path.SysWritLn(pTerm, 0, msg, 12, 0)

		// Read first 32-byte directory entry from CMDS
		var dirEntry [32]byte
		n, rerr := path.SysRead(pDir, 0, &dirEntry[0], 32)
		if n == 32 && rerr == 0 {
			msgEntry := (*byte)("DIR:ENTRY:OK")
			path.SysWritLn(pTerm, 0, msgEntry, 12, 0)
		}

		path.SysClose(pDir)
	}

	// 3. Test SysCreate on /log device
	logPath := (*byte)("/log")
	pLog, errLog := path.SysCreate(0, logPath, path.MODE_WRITE, 0, 0, 0)
	if errLog == 0 {
		msgLog := (*byte)("PATH:LOG:OK")
		path.SysWritLn(pLog, 0, msgLog, 11, 0)
		path.SysClose(pLog)
	}

	if pTerm != 0xFF {
		path.SysClose(pTerm)
	}

	hal.Exit(0)
}
