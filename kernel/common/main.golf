package main

import "hal"
import "klib"
import "dev"
import "path"
import "proc"
import "syscall"
import "tables"

func launchShell() {
	termPath := (*byte)("/term")
	logPath := (*byte)("/log")

	// Initial Userland Shell setup
	hal.EnableTimer()
	proc.SetCurrentPID(0)

	// Initialize Process 0 standard paths and directories for inheritance
	proc.ProcOpen(0, termPath, path.MODE_READ)
	proc.ProcOpen(0, termPath, path.MODE_WRITE)
	proc.ProcOpen(0, termPath, path.MODE_WRITE)
	proc.ProcOpen(0, logPath, path.MODE_WRITE)

	proc.SysChgDir((*byte)("/d0"), 0)
	cxdErr := byte(0)
	if hal.ARCH == 'k' {
		cxdErr = proc.SysChgDir((*byte)("/d0/CmdsK"), path.MODE_EXEC)
	} else if hal.ARCH == 'z' {
		cxdErr = proc.SysChgDir((*byte)("/d0/CmdsZ"), path.MODE_EXEC)
	} else {
		cxdErr = proc.SysChgDir((*byte)("/d0/Cmds9"), path.MODE_EXEC)
	}
	if cxdErr != 0 {
		dev.KLog((*byte)("CHGDIR:FAIL"))
	} else {
		dev.KLog((*byte)("CHGDIR:OK"))
	}

	// Launch initial userland shell (Task 3+)
	shCmd := (*byte)("SH")
	shErr := proc.SysFork(shCmd, (*byte)(0), 0)
	shPID := proc.ForkedChildPID
	if shErr == 0 && shPID > 0 {
		dev.KLog((*byte)("SHELL:FORK:OK"))
		for {
			werr := proc.SysWait()
			if werr != 0 || proc.WaitChildPID == shPID {
				break
			}
		}
	} else {
		dev.KLog((*byte)("SHELL:FORK:FAIL"))
	}

	hal.Exit(0)
}

func main() {
	tables.Init()
	dev.KLog((*byte)("Hatvan OS"))

	proc.ProcInit()
	path.PathInit()
	syscall.SyscallInit()

	launchShell()
}
