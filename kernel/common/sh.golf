package sh

import "dev"
import "hal"
import "klib"
import "path"
import "proc"

var lineBuf [128]byte
var cmdName [32]byte
var argBuf [128]byte
var redirBuf [64]byte
var redirInBuf [64]byte

func printStr(s *byte) {
	n := klib.strlen(s)
	if n > 0 {
		dev.TermWrite(0, word(s), n)
	}
}

func printHexWord(val word) {
	for i := word(0); i < 4; i++ {
		shift := (3 - i) * 4
		nib := byte((val >> shift) & 0xF)
		if nib < 10 {
			hal.PutChar('0' + nib)
		} else {
			hal.PutChar('A' + nib - 10)
		}
	}
}

func printDec(val byte) {
	if val == 0 {
		hal.PutChar('0')
		return
	}
	var buf [4]byte
	n := word(0)
	v := val
	for v > 0 {
		buf[n] = '0' + (v % 10)
		n++
		v = v / 10
	}
	for n > 0 {
		n--
		hal.PutChar(buf[n])
	}
}

// RunCommand parses and executes a single command line string
func RunCommand(line *byte) byte {
	p := line
	// 1. Skip leading spaces
	for peekb(word(p)) == ' ' {
		p = (*byte)(word(p) + 1)
	}

	c0 := peekb(word(p))
	if c0 == 0 || c0 == '\r' || c0 == '\n' {
		return 0
	}

	// 2. Extract command token into cmdName
	cmdLen := word(0)
	for cmdLen < 31 {
		c := peekb(word(p))
		if c == 0 || c == ' ' || c == '\r' || c == '\n' {
			break
		}
		pokeb(word(&cmdName[0])+cmdLen, c)
		cmdLen++
		p = (*byte)(word(p) + 1)
	}
	pokeb(word(&cmdName[0])+cmdLen, 0)

	// 3. Extract arguments into argBuf (CR terminated), checking for '>'
	for peekb(word(p)) == ' ' {
		p = (*byte)(word(p) + 1)
	}

	argLen := word(0)
	redirLen := word(0)
	redirInLen := word(0)
	isBg := false
	pokeb(word(&redirBuf[0]), 0)
	pokeb(word(&redirInBuf[0]), 0)

	inSingle := false
	inDouble := false

	for {
		c := peekb(word(p))
		if c == 0 || c == '\r' || c == '\n' {
			break
		}
		if c == '\'' && !inDouble {
			inSingle = !inSingle
			if argLen < 126 {
				pokeb(word(&argBuf[0])+argLen, c)
				argLen++
			}
			p = (*byte)(word(p) + 1)
			continue
		}
		if c == '"' && !inSingle {
			inDouble = !inDouble
			if argLen < 126 {
				pokeb(word(&argBuf[0])+argLen, c)
				argLen++
			}
			p = (*byte)(word(p) + 1)
			continue
		}

		if !inSingle && !inDouble {
			if c == '>' {
				p = (*byte)(word(p) + 1)
				for peekb(word(p)) == ' ' {
					p = (*byte)(word(p) + 1)
				}
				redirLen = 0
				for redirLen < 63 {
					ch := peekb(word(p))
					if ch == 0 || ch == ' ' || ch == '\r' || ch == '\n' || ch == '<' || ch == '&' {
						break
					}
					pokeb(word(&redirBuf[0])+redirLen, ch)
					redirLen++
					p = (*byte)(word(p) + 1)
				}
				pokeb(word(&redirBuf[0])+redirLen, 0)
				continue
			}
			if c == '<' {
				p = (*byte)(word(p) + 1)
				for peekb(word(p)) == ' ' {
					p = (*byte)(word(p) + 1)
				}
				redirInLen = 0
				for redirInLen < 63 {
					ch := peekb(word(p))
					if ch == 0 || ch == ' ' || ch == '\r' || ch == '\n' || ch == '>' || ch == '&' {
						break
					}
					pokeb(word(&redirInBuf[0])+redirInLen, ch)
					redirInLen++
					p = (*byte)(word(p) + 1)
				}
				pokeb(word(&redirInBuf[0])+redirInLen, 0)
				continue
			}
			if c == '&' {
				isBg = true
				p = (*byte)(word(p) + 1)
				continue
			}
		}

		if redirLen == 0 && redirInLen == 0 {
			if argLen < 126 {
				pokeb(word(&argBuf[0])+argLen, c)
				argLen++
			}
		}
		p = (*byte)(word(p) + 1)
	}

	for argLen > 0 && peekb(word(&argBuf[0])+argLen-1) == ' ' {
		argLen--
	}
	pokeb(word(&argBuf[0])+argLen, '\r')
	pokeb(word(&argBuf[0])+argLen+1, 0)
	argLen++ // count includes '\r'

	// 4. Check builtin commands
	if klib.streq(&cmdName[0], (*byte)("help")) {
		printStr((*byte)("Hatvan OS Shell Builtins: help, exit, pwd, pxd, cd, cx\n"))
		return 0
	}

	if klib.streq(&cmdName[0], (*byte)("exit")) {
		hal.Exit(0)
		return 0
	}

	if klib.streq(&cmdName[0], (*byte)("pwd")) {
		curPID := proc.CurrentPID
		procEntry := proc.GetProc(curPID)
		if procEntry.CwdPath[0] != 0 {
			printStr(&procEntry.CwdPath[0])
			hal.PutChar('\n')
		} else {
			printStr((*byte)("/d"))
			hal.PutChar('0' + procEntry.CwdDrive)
			hal.PutChar('\n')
		}
		return 0
	}

	if klib.streq(&cmdName[0], (*byte)("pxd")) || klib.streq(&cmdName[0], (*byte)("pwx")) {
		curPID := proc.CurrentPID
		procEntry := proc.GetProc(curPID)
		if procEntry.CxdPath[0] != 0 {
			printStr(&procEntry.CxdPath[0])
			hal.PutChar('\n')
		} else {
			printStr((*byte)("/d"))
			hal.PutChar('0' + procEntry.CxdDrive)
			hal.PutChar('\n')
		}
		return 0
	}

	if klib.streq(&cmdName[0], (*byte)("cd")) {
		idx := word(0)
		for argBuf[idx] == ' ' {
			idx++
		}
		end := idx
		for argBuf[end] != 0 && argBuf[end] != '\r' && argBuf[end] != '\n' && argBuf[end] != ' ' {
			end++
		}
		argBuf[end] = 0
		err := proc.SysChgDir(&argBuf[idx], 0)
		if err != 0 {
			printStr((*byte)("cd: path not found\n"))
		}
		return err
	}

	if klib.streq(&cmdName[0], (*byte)("cx")) {
		idx := word(0)
		for argBuf[idx] == ' ' {
			idx++
		}
		end := idx
		for argBuf[end] != 0 && argBuf[end] != '\r' && argBuf[end] != '\n' && argBuf[end] != ' ' {
			end++
		}
		argBuf[end] = 0
		err := proc.SysChgDir(&argBuf[idx], path.MODE_EXEC)
		if err != 0 {
			printStr((*byte)("cx: path not found\n"))
		}
		return err
	}

	// 5. External executable binary execution from cxd
	err := proc.SysFork(&cmdName[0], &argBuf[0], argLen)
	cpid := proc.ForkedChildPID
	if err != 0 {
		printStr(&cmdName[0])
		printStr((*byte)(": not found\n"))
		return err
	}

	if cpid > 0 {
		if redirInBuf[0] != 0 {
			curP := proc.GetProc(cpid)
			newPathId, oErr := path.SysOpen(cpid, &redirInBuf[0], path.MODE_READ, curP.CwdDrive, curP.CwdFDLSN, curP.CxdFDLSN)
			if oErr == 0 {
				oldPathId := curP.Paths[0]
				if oldPathId != 0xFF {
					path.SysClose(oldPathId)
				}
				curP.Paths[0] = newPathId
			} else {
				printStr((*byte)("cannot open redirection input\n"))
			}
		}

		if redirBuf[0] != 0 {
			curP := proc.GetProc(cpid)
			newPathId, cErr := path.SysCreate(cpid, &redirBuf[0], path.MODE_WRITE, curP.CwdDrive, curP.CwdFDLSN, curP.CxdFDLSN)
			if cErr == 0 {
				oldPathId := curP.Paths[1]
				if oldPathId != 0xFF {
					path.SysClose(oldPathId)
				}
				curP.Paths[1] = newPathId
			} else {
				printStr((*byte)("cannot create redirection file\n"))
			}
		}

		if isBg {
			return 0
		}

		proc.SetProcState(proc.CurrentPID, proc.PROC_WAITING)
		cp := proc.GetProc(cpid)
		hal.LaunchProcess(cpid, cp.SavedSP, cp.SavedPC)
		for {
			wpid, wst, werr := proc.SysWait()
			proc.SetProcState(proc.CurrentPID, proc.PROC_RUNNING)
			if werr != 0 {
				break
			}
			if wpid == cpid {
				if wst != 0 {
					printStr((*byte)("ERROR "))
					printDec(wst)
					hal.PutChar('\n')
				}
				return wst
			}
		}
	}

	return 0
}

// RunShell runs an interactive shell prompt loop reading from console into Task 0 lineBuf
func RunShell() {
	for {
		printStr((*byte)("....hatvan% "))

		n := dev.TermReadLn(0, word(&lineBuf[0]), 128, 0)
		if n == 0 {
			break
		}
		lineBuf[n] = 0

		RunCommand(&lineBuf[0])
	}
}
