package syscall

import "dev"
import "hal"
import "klib"
import "path"
import "proc"
import "rbf_ipc"

// OS-9 System Call Numbers
const F_LINK = 0x00   // F$Link
const F_LOAD = 0x01   // F$Load
const F_UNLINK = 0x02 // F$UnLink
const F_FORK = 0x03   // F$Fork
const F_WAIT = 0x04   // F$Wait
const F_CHAIN = 0x05  // F$Chain
const F_EXIT = 0x06   // F$Exit
const F_MEM = 0x07    // F$Mem
const F_SLEEP = 0x0A  // F$Sleep
const F_ID = 0x0C     // F$ID
const F_PERR = 0x0F   // F$PErr
const F_PRSNAM = 0x10 // F$PrsNam
const F_TIME = 0x15   // F$Time

const I_OPEN = 0x84   // I$Open
const I_CREATE = 0x85 // I$Create
const I_CHGDIR = 0x86 // I$ChgDir
const I_DELETE = 0x87 // I$Delete
const I_SEEK = 0x88   // I$Seek
const I_READ = 0x89   // I$Read
const I_WRITE = 0x8A  // I$Write
const I_READLN = 0x8B // I$ReadLn
const I_WRITLN = 0x8C // I$WritLn
const I_GETSTT = 0x8D // I$GetStt
const I_SETSTT = 0x8E // I$SetStt
const I_CLOSE = 0x8F  // I$Close

// SyscallFrame holds the registers saved from the user stack
type SyscallFrame struct {
	CC byte
	A  byte
	B  byte
	DP byte
	X  word
	Y  word
	U  word
	PC word
}

var UserFrame SyscallFrame
var pathBuf [128]byte
var paramBuf [128]byte

func SyscallInit() {
	Dispatch(0xFF)
}

// CopyUserString copies a string from user task space into kernel buffer.
// Stops at NUL, CR, LF, space, or comma. Returns string length.
func CopyUserString(task byte, userAddr word, dst *byte, maxLen word) word {
	count := word(0)
	dstAddr := word(dst)
	for count < maxLen-1 {
		c := byte(0)
		hal.DMACopy(task, userAddr+count, 0, word(&c), 1)
		if c == 0 || c == '\r' || c == '\n' || c == ' ' || c == ',' {
			break
		}
		pokeb(dstAddr+count, c)
		count++
	}
	pokeb(dstAddr+count, 0)
	return count
}

// CopyUserParams copies parameter bytes from user task space into kernel buffer
func CopyUserParams(task byte, userAddr word, dst *byte, count word) word {
	if count == 0 {
		pokeb(word(dst), 0)
		return 0
	}
	chunk := count
	if chunk > 127 {
		chunk = 127
	}
	hal.DMACopy(task, userAddr, 0, word(dst), chunk)
	pokeb(word(dst)+chunk, 0)
	return chunk
}

// Dispatch executes a system call requested by the current user task.
// Updates UserFrame registers and CC (clearing carry on success, setting carry on error).
func Dispatch(callNum byte) {
	curPID := proc.CurrentPID

	if callNum == I_OPEN {
		count := CopyUserString(curPID, UserFrame.X, &pathBuf[0], 128)
		slot, err := proc.ProcOpen(curPID, &pathBuf[0], UserFrame.A)
		if err == 0 {
			UserFrame.A = slot
			UserFrame.X += count
			UserFrame.CC &^= 1 // clear CC.C
		} else {
			UserFrame.B = err
			UserFrame.CC |= 1 // set CC.C
		}
		return
	}

	if callNum == I_CREATE {
		count := CopyUserString(curPID, UserFrame.X, &pathBuf[0], 128)
		slot, err := proc.ProcCreate(curPID, &pathBuf[0], UserFrame.A)
		if err == 0 {
			UserFrame.A = slot
			UserFrame.X += count
			UserFrame.CC &^= 1
		} else {
			UserFrame.B = err
			UserFrame.CC |= 1
		}
		return
	}

	if callNum == I_CLOSE {
		err := proc.ProcClose(curPID, UserFrame.A)
		if err == 0 {
			UserFrame.CC &^= 1
		} else {
			UserFrame.B = err
			UserFrame.CC |= 1
		}
		return
	}

	if callNum == I_READ {
		n, err := proc.ProcRead(curPID, UserFrame.A, (*byte)(UserFrame.X), UserFrame.Y)
		UserFrame.Y = n
		if err == 0 {
			UserFrame.CC &^= 1
		} else {
			UserFrame.B = err
			UserFrame.CC |= 1
		}
		return
	}

	if callNum == I_WRITE {
		n, err := proc.ProcWrite(curPID, UserFrame.A, (*byte)(UserFrame.X), UserFrame.Y)
		UserFrame.Y = n
		if err == 0 {
			UserFrame.CC &^= 1
		} else {
			UserFrame.B = err
			UserFrame.CC |= 1
		}
		return
	}

	if callNum == I_READLN {
		n, err := proc.ProcReadLn(curPID, UserFrame.A, (*byte)(UserFrame.X), UserFrame.Y)
		UserFrame.Y = n
		if err == 0 {
			UserFrame.CC &^= 1
		} else {
			UserFrame.B = err
			UserFrame.CC |= 1
		}
		return
	}

	if callNum == I_WRITLN {
		n, err := proc.ProcWritLn(curPID, UserFrame.A, (*byte)(UserFrame.X), UserFrame.Y)
		UserFrame.Y = n
		if err == 0 {
			UserFrame.CC &^= 1
		} else {
			UserFrame.B = err
			UserFrame.CC |= 1
		}
		return
	}

	if callNum == I_SEEK {
		if UserFrame.A < proc.PROC_MAX_PATHS {
			pathId := proc.ProcTable[curPID].Paths[UserFrame.A]
			if pathId != 0xFF {
				seekPos := UserFrame.U
				if hal.ARCH == 'k' {
					seekPos = UserFrame.X
				}
				err := path.SysSeek(pathId, seekPos)
				if err == 0 {
					UserFrame.CC &^= 1
					return
				}
				UserFrame.B = err
				UserFrame.CC |= 1
				return
			}
		}
		UserFrame.B = proc.E_BPNUM
		UserFrame.CC |= 1
		return
	}

	if callNum == I_CHGDIR {
		count := CopyUserString(curPID, UserFrame.X, &pathBuf[0], 128)
		err := proc.SysChgDir(&pathBuf[0], UserFrame.A)
		if err == 0 {
			UserFrame.X += count
			UserFrame.CC &^= 1
		} else {
			UserFrame.B = err
			UserFrame.CC |= 1
		}
		return
	}

	if callNum == F_LINK {
		// Module linking: not currently in RAM, return E$MNF (218) to fallback to disk
		UserFrame.B = 218
		UserFrame.CC |= 1
		return
	}

	if callNum == F_LOAD {
		// F$Load: for shell fork preparation, point U to modbuf where header was read ($5E past U)
		UserFrame.U += 0x5E
		UserFrame.CC &^= 1
		return
	}

	if callNum == F_UNLINK || callNum == F_PERR {
		UserFrame.CC &^= 1
		return
	}

	if callNum == F_PRSNAM {
		uAddr := UserFrame.X
		firstChar := byte(0)
		hal.DMACopy(curPID, uAddr, 0, word(&firstChar), 1)
		if firstChar == '/' {
			uAddr++
		}
		startX := uAddr
		yAddr := uAddr

		c0 := byte(0)
		hal.DMACopy(curPID, yAddr, 0, word(&c0), 1)
		raw0 := c0
		ascii0 := raw0 & 0x7F

		isLegalFirst := false
		if (ascii0 >= 'A' && ascii0 <= 'Z') || (ascii0 >= 'a' && ascii0 <= 'z') ||
			(ascii0 >= '0' && ascii0 <= '9') || ascii0 == '_' {
			isLegalFirst = true
		}

		if !isLegalFirst {
			for raw0 == ' ' || raw0 == ',' {
				yAddr++
				hal.DMACopy(curPID, yAddr, 0, word(&raw0), 1)
			}
			UserFrame.Y = yAddr
			UserFrame.B = 215 // E_BPNAM
			UserFrame.CC |= 1
			return
		}

		nameLen := byte(0)
		delim := byte(0)
		for {
			nameLen++
			yAddr++
			if (raw0 & 0x80) != 0 {
				delim = raw0
				break
			}

			cNext := byte(0)
			hal.DMACopy(curPID, yAddr, 0, word(&cNext), 1)
			raw0 = cNext
			asciiNext := raw0 & 0x7F

			isLegalNext := false
			if (asciiNext >= 'A' && asciiNext <= 'Z') || (asciiNext >= 'a' && asciiNext <= 'z') ||
				(asciiNext >= '0' && asciiNext <= '9') || asciiNext == '_' || asciiNext == '.' {
				isLegalNext = true
			}

			if !isLegalNext {
				delim = raw0
				break
			}
		}

		UserFrame.X = startX
		UserFrame.Y = yAddr
		UserFrame.A = delim
		UserFrame.B = nameLen
		UserFrame.CC &^= 1
		return
	}

	if callNum == F_FORK {
		CopyUserString(curPID, UserFrame.X, &pathBuf[0], 128)
		plen := CopyUserParams(curPID, UserFrame.U, &paramBuf[0], UserFrame.Y)
		childPID, err := proc.SysFork(&pathBuf[0], &paramBuf[0], plen)
		if err == 0 {
			UserFrame.A = childPID
			UserFrame.CC &^= 1
		} else {
			UserFrame.B = err
			UserFrame.CC |= 1
		}
		return
	}

	if callNum == F_WAIT {
		cpid, st, err := proc.SysWait()
		if err == 0 {
			UserFrame.A = cpid
			UserFrame.B = st
			UserFrame.CC &^= 1
		} else {
			UserFrame.B = err
			UserFrame.CC |= 1
		}
		return
	}

	if callNum == F_EXIT {
		proc.SysExit(UserFrame.B)
		return
	}

	if callNum == F_ID {
		UserFrame.A = curPID
		UserFrame.CC &^= 1
		return
	}

	if callNum == F_SLEEP {
		UserFrame.CC &^= 1
		return
	}

	if callNum == F_TIME {
		var timeBuf [6]byte
		timeBuf[0] = 1 // Year 1901
		timeBuf[1] = 1 // Month 1
		timeBuf[2] = 1 // Day 1
		timeBuf[3] = 1 // Hour 1
		timeBuf[4] = 1 // Minute 1
		timeBuf[5] = 1 // Second 1
		hal.DMACopy(0, word(&timeBuf[0]), curPID, UserFrame.X, 6)
		UserFrame.CC &^= 1
		return
	}

	if callNum == I_GETSTT {
		pathSlot := UserFrame.A
		if pathSlot >= proc.PROC_MAX_PATHS {
			UserFrame.B = proc.E_BPNUM
			UserFrame.CC |= 1
			return
		}
		pathId := proc.ProcTable[curPID].Paths[pathSlot]
		if pathId == 0xFF || pathId >= path.MAX_PATHS {
			UserFrame.B = proc.E_BPNUM
			UserFrame.CC |= 1
			return
		}
		pd := &path.PathTable[pathId]

		code := UserFrame.B
		if code == 0x26 { // SS.ScSiz (screen size)
			UserFrame.X = 80
			UserFrame.CC &^= 1
			return
		}

		if code == 0x06 { // SS.EOF (check EOF)
			if pd.FilePos >= pd.FileSize {
				UserFrame.B = path.E_EOF
				UserFrame.CC |= 1
			} else {
				UserFrame.CC &^= 1
			}
			return
		}

		if code == 0x20 { // SS.FDInf (file descriptor sector info)
			fdLSN := UserFrame.U
			if sizeof[word]() > 2 {
				fdLSN = (word(UserFrame.Y>>8) << 16) | UserFrame.U
			}
			cnt := UserFrame.Y & 0xFF
			if cnt > 256 {
				cnt = 256
			}
			err := rbf_ipc.GetFDInf(pd.Drive, fdLSN, curPID, UserFrame.X, cnt)
			if err == 0 {
				UserFrame.CC &^= 1
			} else {
				UserFrame.B = err
				UserFrame.CC |= 1
			}
			return
		}

		UserFrame.B = path.E_BMODE
		UserFrame.CC |= 1
		return
	}

	if callNum == I_SETSTT {
		UserFrame.CC &^= 1
		return
	}

	// Unknown syscall: set error 214 (E_BMODE)
	UserFrame.B = 214
	UserFrame.CC |= 1
}
