package proc

import "hal"
import "klib"
import "rbf_ipc"
import "dev"
import "path"
import "loader"

const MAX_PROCS = 16
const PROC_MAX_PATHS = 16

const PROC_FREE = 0
const PROC_READY = 1
const PROC_RUNNING = 2
const PROC_WAITING = 3
const PROC_ZOMBIE = 4

// OS-9 Error codes
const E_PNNF = 216      // Path name not found
const E_BPNUM = 217     // Bad path number
const E_PTHFUL = 218    // Path table full
const E_NOCHILD = 222   // No children
const E_NOTREADY = 223  // Child not ready
const E_PROCUNDEF = 224 // Process undefined / bad PID
const E_PROCFUL = 225   // Process table full

type Process struct {
	PID         byte
	State       byte
	ParentPID   byte
	TaskID      byte
	ExitStatus  byte
	SavedSP     word
	SavedPC     word
	SavedU      word
	Paths       [PROC_MAX_PATHS]byte
	CwdDrive    byte
	CwdFDLSN    word
	CwdPath     [32]byte
	CxdDrive    byte
	CxdFDLSN    word
	CxdPath     [32]byte
	LineMode    byte // 0 = '\n' (Unix), 1 = '\r' (OS-9)
	CodeStart   word
	CodeSize    word
	DataTop     word
	StackBottom word
	CmdName     [16]byte
}

var ProcTable [MAX_PROCS]Process
var CurrentPID byte

func SetCurrentPID(pid byte) {
	CurrentPID = pid
}

// ProcInit initializes the process subsystem
func ProcInit() {
	for i := word(0); i < MAX_PROCS; i++ {
		p := &ProcTable[i]
		p.PID = byte(i)
		p.State = PROC_FREE
		p.ParentPID = 0
		p.TaskID = byte(i)
		p.ExitStatus = 0
		p.SavedSP = 0
		p.SavedPC = 0
		p.SavedU = 0
		p.LineMode = 0
		p.CwdDrive = 0
		p.CwdFDLSN = 0
		p.CwdPath[0] = 0
		p.CxdDrive = 0
		p.CxdFDLSN = 0
		p.CxdPath[0] = 0
		p.CodeStart = 0
		p.CodeSize = 0
		p.DataTop = 0
		p.StackBottom = 0
		p.CmdName[0] = 0
		for k := word(0); k < PROC_MAX_PATHS; k++ {
			p.Paths[k] = 0xFF
		}
		if i > 1 {
			hal.PurgeTaskMem(byte(i))
		}
	}

	// Process 0 is Task 0 (Kernel)
	ProcTable[0].State = PROC_RUNNING
	if hal.ARCH == '9' {
		ProcTable[0].SavedSP = 0x3800
	}
	klib.strcpy(&ProcTable[0].CmdName[0], (*byte)("kernel"))

	// Process 1 is Task 1 ([RBF])
	ProcTable[1].State = PROC_WAITING
	ProcTable[1].ParentPID = 0
	ProcTable[1].TaskID = 1
	ProcTable[1].SavedSP = 0xFE00
	klib.strcpy(&ProcTable[1].CmdName[0], (*byte)("[RBF]"))
	hal.SetTaskFlags(1)
	if hal.ARCH == '9' {
		hal.InitRBF(0x4000)
	} else {
		hal.InitRBF(0x00001000)
	}

	CurrentPID = 0
}

// ProcAlloc finds a free process slot and initializes it,
// inheriting cwd, cxd, lineMode, and standard paths 0, 1, 2, 3 (stdin, stdout, stderr, stdlog).
func ProcAlloc(parentPID byte) (byte, *Process) {
	for i := word(1); i < MAX_PROCS; i++ {
		if ProcTable[i].State == PROC_FREE {
			p := &ProcTable[i]
			p.State = PROC_READY
			p.ParentPID = parentPID
			p.TaskID = byte(i)
			p.ExitStatus = 0
			p.SavedSP = 0xFE00
			p.SavedPC = 0
			p.SavedU = 0
			p.LineMode = 0
			p.CwdDrive = 0
			p.CwdFDLSN = 0
			p.CwdPath[0] = 0
			p.CxdDrive = 0
			p.CxdFDLSN = 0
			p.CxdPath[0] = 0
			p.CodeStart = 0
			p.CodeSize = 0
			p.DataTop = 0
			p.StackBottom = 0
			p.CmdName[0] = 0

			for k := word(0); k < PROC_MAX_PATHS; k++ {
				p.Paths[k] = 0xFF
			}

			if parentPID < MAX_PROCS && ProcTable[parentPID].State != PROC_FREE {
				parent := &ProcTable[parentPID]
				p.CwdDrive = parent.CwdDrive
				p.CwdFDLSN = parent.CwdFDLSN
				klib.strcpy(&p.CwdPath[0], &parent.CwdPath[0])
				p.CxdDrive = parent.CxdDrive
				p.CxdFDLSN = parent.CxdFDLSN
				klib.strcpy(&p.CxdPath[0], &parent.CxdPath[0])
				p.LineMode = parent.LineMode

				// Inherit standard paths 0, 1, 2, 3 (stdin, stdout, stderr, stdlog)
				for sp := word(0); sp < 4; sp++ {
					parentPathId := parent.Paths[sp]
					if parentPathId != 0xFF && parentPathId < path.MAX_PATHS {
						p.Paths[sp] = parentPathId
						path.PathTable[parentPathId].RefCount++
					}
				}
			}

			return byte(i), p
		}
	}
	return 0xFF, (*Process)(0)
}

// ProcFree terminates a process slot and closes all associated paths
func ProcFree(pid byte) {
	if pid <= 1 || pid >= MAX_PROCS {
		return
	}
	p := &ProcTable[pid]
	for k := word(0); k < PROC_MAX_PATHS; k++ {
		pathId := p.Paths[k]
		if pathId != 0xFF {
			path.SysClose(pathId)
			p.Paths[k] = 0xFF
		}
	}
	p.State = PROC_FREE
	hal.PurgeTaskMem(p.TaskID)
}

// ProcOpen opens a path for the given process and assigns a per-process path descriptor
func ProcOpen(pid byte, pathStr *byte, mode byte) (byte, byte) {
	if pid >= MAX_PROCS || ProcTable[pid].State == PROC_FREE {
		return 0xFF, E_PROCUNDEF
	}
	p := &ProcTable[pid]

	// Find available per-process path slot
	slot := byte(0xFF)
	for k := word(0); k < PROC_MAX_PATHS; k++ {
		if p.Paths[k] == 0xFF {
			slot = byte(k)
			break
		}
	}
	if slot == 0xFF {
		return 0xFF, E_PTHFUL
	}

	pathId, err := path.SysOpen(pid, pathStr, mode, p.CwdDrive, p.CwdFDLSN, p.CxdFDLSN)
	if err != 0 {
		return 0xFF, err
	}

	if path.PathTable[pathId].DevType == dev.DEV_PROC {
		perr := ProcfsOpen(pathId, pathStr)
		if perr != 0 {
			path.SysClose(pathId)
			return 0xFF, perr
		}
	}

	p.Paths[slot] = pathId
	return slot, 0
}

// ProcCreate creates or opens a path for writing for the given process
func ProcCreate(pid byte, pathStr *byte, mode byte) (byte, byte) {
	if pid >= MAX_PROCS || ProcTable[pid].State == PROC_FREE {
		return 0xFF, E_PROCUNDEF
	}
	p := &ProcTable[pid]

	slot := byte(0xFF)
	for k := word(0); k < PROC_MAX_PATHS; k++ {
		if p.Paths[k] == 0xFF {
			slot = byte(k)
			break
		}
	}
	if slot == 0xFF {
		return 0xFF, E_PTHFUL
	}

	pathId, err := path.SysCreate(pid, pathStr, mode, p.CwdDrive, p.CwdFDLSN, p.CxdFDLSN)
	if err != 0 {
		return 0xFF, err
	}

	p.Paths[slot] = pathId
	return slot, 0
}

// ProcDelete deletes a file for the given process
func ProcDelete(pid byte, pathStr *byte) byte {
	if pid >= MAX_PROCS || ProcTable[pid].State == PROC_FREE {
		return E_PROCUNDEF
	}
	p := &ProcTable[pid]
	return path.SysDelete(pid, pathStr, p.CwdDrive, p.CwdFDLSN, p.CxdFDLSN)
}

// ProcClose closes a per-process path descriptor
func ProcClose(pid byte, procPath byte) byte {
	if pid >= MAX_PROCS || ProcTable[pid].State == PROC_FREE {
		return E_PROCUNDEF
	}
	if procPath >= PROC_MAX_PATHS {
		return E_BPNUM
	}
	p := &ProcTable[pid]
	pathId := p.Paths[procPath]
	if pathId == 0xFF {
		return E_BPNUM
	}

	path.SysClose(pathId)
	p.Paths[procPath] = 0xFF
	return 0
}

// ProcRead reads from a per-process path into user buffer
func ProcRead(pid byte, procPath byte, ubuf *byte, count word) (word, byte) {
	if pid >= MAX_PROCS || ProcTable[pid].State == PROC_FREE {
		return 0, E_PROCUNDEF
	}
	if procPath >= PROC_MAX_PATHS {
		return 0, E_BPNUM
	}
	pathId := ProcTable[pid].Paths[procPath]
	if pathId == 0xFF {
		return 0, E_BPNUM
	}
	return path.SysRead(pathId, pid, ubuf, count)
}

// ProcWrite writes to a per-process path from user buffer
func ProcWrite(pid byte, procPath byte, ubuf *byte, count word) (word, byte) {
	if pid >= MAX_PROCS || ProcTable[pid].State == PROC_FREE {
		return 0, E_PROCUNDEF
	}
	if procPath >= PROC_MAX_PATHS {
		return 0, E_BPNUM
	}
	pathId := ProcTable[pid].Paths[procPath]
	if pathId == 0xFF {
		return 0, E_BPNUM
	}
	return path.SysWrite(pathId, pid, ubuf, count)
}

// ProcReadLn reads a line of text using the process's lineMode setting
func ProcReadLn(pid byte, procPath byte, ubuf *byte, maxLen word) (word, byte) {
	if pid >= MAX_PROCS || ProcTable[pid].State == PROC_FREE {
		return 0, E_PROCUNDEF
	}
	if procPath >= PROC_MAX_PATHS {
		return 0, E_BPNUM
	}
	p := &ProcTable[pid]
	pathId := p.Paths[procPath]
	if pathId == 0xFF {
		return 0, E_BPNUM
	}
	return path.SysReadLn(pathId, pid, ubuf, maxLen, p.LineMode)
}

// ProcWritLn writes a line of text using the process's lineMode setting
func ProcWritLn(pid byte, procPath byte, ubuf *byte, count word) (word, byte) {
	if pid >= MAX_PROCS || ProcTable[pid].State == PROC_FREE {
		return 0, E_PROCUNDEF
	}
	if procPath >= PROC_MAX_PATHS {
		return 0, E_BPNUM
	}
	p := &ProcTable[pid]
	pathId := p.Paths[procPath]
	if pathId == 0xFF {
		return 0, E_BPNUM
	}
	return path.SysWritLn(pathId, pid, ubuf, count, p.LineMode)
}

// extractCmdName copies the basename of cmdPath (without directory prefix) into dst (up to 15 chars)
func extractCmdName(src *byte, dst *byte) {
	p := word(src)
	lastSlash := p
	hasSlash := false
	for {
		c := peekb(p)
		if c == 0 || c == ' ' || c == '\r' || c == '\n' {
			break
		}
		if c == '/' {
			hasSlash = true
			lastSlash = p + 1
		}
		p++
	}
	start := word(src)
	if hasSlash {
		start = lastSlash
	}
	d := word(dst)
	idx := word(0)
	for idx < 15 {
		c := peekb(start + idx)
		if c == 0 || c == ' ' || c == '\r' || c == '\n' || c == '/' {
			break
		}
		pokeb(d+idx, c)
		idx++
	}
	pokeb(d+idx, 0)
}

// SysFork spawns a child process, loads the binary executable from cmdPath,
// marshalls command parameters onto the child stack, and prepares it for execution.
func SysFork(cmdPath *byte, paramStr *byte, paramLen word) (byte, byte) {
	childPID, childProc := ProcAlloc(CurrentPID)
	if childPID == 0xFF {
		return 0xFF, E_PROCFUL
	}
	extractCmdName(cmdPath, &childProc.CmdName[0])

	// Open binary from cxd (execution directory) or absolute path
	binPathId, err := path.SysOpen(CurrentPID, cmdPath, path.MODE_READ|path.MODE_EXEC, childProc.CxdDrive, childProc.CwdFDLSN, childProc.CxdFDLSN)
	if err != 0 {
		ProcFree(childPID)
		return 0xFF, err
	}

	// Load binary into child task space
	entryPC, binSize, lerr := loader.LoadBinary(binPathId, childProc.TaskID, 0x0200)
	path.SysClose(binPathId)
	if lerr != 0 {
		ProcFree(childPID)
		return 0xFF, lerr
	}

	childProc.LineMode = loader.LastLoadedIsOS9
	codeStart := word(0x0200)

	if hal.ARCH == 'k' {
		sp := word(0xFE00)
		if paramStr != (*byte)(0) && paramLen > 0 {
			sp -= (paramLen + 1)
			sp &^= 1
			hal.DMACopy(0, word(paramStr), childProc.TaskID, sp, paramLen)
			cr := byte('\r')
			hal.DMACopy(0, word(&cr), childProc.TaskID, sp+paramLen, 1)
		}
		childProc.SavedSP = sp
		childProc.CodeStart = 0x0200
	} else if hal.ARCH == '9' {
		dpVal := byte(0)
		uVal := word(0)
		paramEnd := word(0xFE00)

		if childProc.LineMode == 1 {
			codeStart = 0xFF00 - binSize
			paramEnd = codeStart & 0xFF00
			dpVal = 0
			uVal = 0
		}

		sp := paramEnd
		paramAddr := paramEnd
		paramLenVal := word(0)
		if paramStr != (*byte)(0) && paramLen > 0 {
			sp -= (paramLen + 1)
			sp &^= 1
			hal.DMACopy(0, word(paramStr), childProc.TaskID, sp, paramLen)
			cr := byte('\r')
			hal.DMACopy(0, word(&cr), childProc.TaskID, sp+paramLen, 1)
			paramAddr = sp
			paramLenVal = paramLen
		}

		frameAddr := sp - 12
		var initFrame [12]byte
		initFrame[0] = 0x80                   // CC: FlagE (Entire frame)
		initFrame[1] = byte(paramLenVal >> 8) // A (D MSB: paramLenVal)
		initFrame[2] = byte(paramLenVal)      // B (D LSB: paramLenVal)
		initFrame[3] = dpVal                  // DP (0x00)
		initFrame[4] = byte(paramAddr >> 8)   // X MSB (parameter pointer)
		initFrame[5] = byte(paramAddr)        // X LSB
		initFrame[6] = byte(paramEnd >> 8)    // Y MSB (paramEnd: top of user memory)
		initFrame[7] = byte(paramEnd)         // Y LSB
		initFrame[8] = byte(uVal >> 8)        // U MSB (0x0000: process data area)
		initFrame[9] = byte(uVal)             // U LSB
		initFrame[10] = byte(entryPC >> 8)    // PC MSB
		initFrame[11] = byte(entryPC)         // PC LSB

		hal.DMACopy(0, word(&initFrame[0]), childProc.TaskID, frameAddr, 12)
		childProc.SavedSP = frameAddr
		childProc.CodeStart = codeStart
	} else {
		panic("?ARCH")
	}

	childProc.SavedPC = entryPC
	childProc.CodeSize = binSize
	childProc.State = PROC_READY

	return childPID, 0
}

// SysExit terminates the current process and records its exit status
func SysExit(status byte) {
	if CurrentPID == 0 {
		hal.Exit(status)
		return
	}

	p := &ProcTable[CurrentPID]

	// Close all open paths
	for k := word(0); k < PROC_MAX_PATHS; k++ {
		pathId := p.Paths[k]
		if pathId != 0xFF {
			path.SysClose(pathId)
			p.Paths[k] = 0xFF
		}
	}

	p.ExitStatus = status
	p.State = PROC_ZOMBIE
	hal.PurgeTaskMem(p.TaskID)

	// Wake parent if waiting
	if p.ParentPID < MAX_PROCS && ProcTable[p.ParentPID].State == PROC_WAITING {
		ProcTable[p.ParentPID].State = PROC_READY
	}
}

// SysWait waits for any child process to terminate and returns (childPID, status, errCode)
func SysWait() (byte, byte, byte) {
	hasChildren := false

	for i := word(1); i < MAX_PROCS; i++ {
		p := &ProcTable[i]
		if p.ParentPID == CurrentPID && p.State != PROC_FREE {
			hasChildren = true
			if p.State == PROC_READY {
				hal.LaunchProcess(byte(i), p.SavedSP, p.SavedPC)
			}
			if p.State == PROC_ZOMBIE {
				cpid := byte(i)
				st := p.ExitStatus
				ProcFree(cpid)
				return cpid, st, 0
			}
		}
	}

	if hasChildren {
		return 0, 0, E_NOTREADY
	}
	return 0, 0, E_NOCHILD
}

func updateProcPath(dstPath *byte, pathStr *byte, drive byte) {
	pStr := word(pathStr)
	dPath := word(dstPath)

	// If pathStr starts with '/'
	if peekb(pStr) == '/' {
		// If it starts with "/d" and a digit '0'..'3'
		if peekb(pStr+1) == 'd' && peekb(pStr+2) >= '0' && peekb(pStr+2) <= '3' {
			// Copy pathStr directly
			klib.strcpy(dstPath, pathStr)
			return
		}

		// Starts with '/', but not "/d0".."/d3": prepend "/d<drive>"
		pokeb(dPath, '/')
		pokeb(dPath+1, 'd')
		pokeb(dPath+2, '0' + drive)
		klib.strcpy((*byte)(dPath+3), pathStr)
		return
	}

	// Relative path
	// Check for "."
	if peekb(pStr) == '.' && peekb(pStr+1) == 0 {
		return
	}

	// Check for ".."
	if peekb(pStr) == '.' && peekb(pStr+1) == '.' && peekb(pStr+2) == 0 {
		curLen := klib.strlen(dstPath)
		lastSlash := word(0)
		for i := word(0); i < curLen; i++ {
			if peekb(dPath+i) == '/' {
				lastSlash = i
			}
		}
		if lastSlash <= 2 {
			pokeb(dPath+3, 0)
		} else {
			pokeb(dPath+lastSlash, 0)
		}
		return
	}

	// Normal relative component
	curLen := klib.strlen(dstPath)
	if curLen == 0 {
		pokeb(dPath, '/')
		pokeb(dPath+1, 'd')
		pokeb(dPath+2, '0' + drive)
		pokeb(dPath+3, '/')
		curLen = 4
		pokeb(dPath+4, 0)
	} else if peekb(dPath+curLen-1) != '/' {
		pokeb(dPath+curLen, '/')
		curLen++
		pokeb(dPath+curLen, 0)
	}
	klib.strcpy((*byte)(dPath+curLen), pathStr)
}

// SysChgDir changes the current working directory (cwd) or execution directory (cxd)
func SysChgDir(pathStr *byte, mode byte) byte {
	p := &ProcTable[CurrentPID]
	devType, _, _ := dev.ParsePathDevice(pathStr, p.CwdDrive)
	if devType != dev.DEV_DISK {
		return path.E_BMODE
	}

	isExec := byte(0)
	if (mode & path.MODE_EXEC) != 0 {
		isExec = 1
	}

	finalDrive, fdLSN, attr, fileSize, err := rbf_ipc.ResolvePath(pathStr, p.CwdDrive, p.CwdFDLSN, p.CxdFDLSN, isExec)
	if err != 0 || finalDrive == 0xFF || fdLSN == 0 {
		return path.E_PNNF
	}

	if (attr & 0x80) == 0 {
		return path.E_BMODE
	}

	if isExec != 0 {
		p.CxdDrive = finalDrive
		p.CxdFDLSN = fdLSN
		updateProcPath(&p.CxdPath[0], pathStr, finalDrive)
	} else {
		p.CwdDrive = finalDrive
		p.CwdFDLSN = fdLSN
		updateProcPath(&p.CwdPath[0], pathStr, finalDrive)
	}

	return 0
}

// ==================== /proc Filesystem ====================

func bufAppendByte(buf *byte, pos *word, b byte) {
	p := *pos
	if p < 254 {
		pokeb(word(buf)+p, b)
		*pos = p + 1
	}
}

func bufAppendStr(buf *byte, pos *word, s *byte) {
	p := word(s)
	for {
		c := peekb(p)
		if c == 0 {
			break
		}
		bufAppendByte(buf, pos, c)
		p++
	}
}

func bufAppendDec(buf *byte, pos *word, val byte, width byte) {
	var tmp [4]byte
	n := word(0)
	v := val
	if v == 0 {
		tmp[0] = '0'
		n = 1
	} else {
		for v > 0 {
			rem := v % 10
			tmp[n] = '0' + rem
			n++
			v = v / 10
		}
	}
	for n < word(width) {
		bufAppendByte(buf, pos, ' ')
		width--
	}
	for n > 0 {
		n--
		bufAppendByte(buf, pos, tmp[n])
	}
}

func bufAppendHexWord(buf *byte, pos *word, val word) {
	for i := word(0); i < 4; i++ {
		shift := (3 - i) * 4
		nib := byte((val >> shift) & 0xF)
		if nib < 10 {
			bufAppendByte(buf, pos, '0'+nib)
		} else {
			bufAppendByte(buf, pos, 'A'+nib-10)
		}
	}
}

// ProcfsFormatProcesses generates a table of active processes into pd.SectorBuf
func ProcfsFormatProcesses(pathId byte) byte {
	pd := &path.PathTable[pathId]
	buf := &pd.SectorBuf[0]
	pos := word(0)

	// Column headers: PID, PPID, STATE, SP, CMD
	bufAppendStr(buf, &pos, (*byte)("  PID  PPID STATE      SP  CMD\n"))

	for i := word(0); i < MAX_PROCS; i++ {
		p := &ProcTable[i]
		if p.State == PROC_FREE {
			continue
		}
		if pos+45 >= 254 {
			break
		}

		// PID (column width 5)
		bufAppendDec(buf, &pos, p.PID, 5)
		bufAppendStr(buf, &pos, (*byte)("  "))

		// PPID (column width 4)
		bufAppendDec(buf, &pos, p.ParentPID, 4)
		bufAppendByte(buf, &pos, ' ')

		// STATE (column width 5 + space)
		if p.PID == CurrentPID {
			bufAppendStr(buf, &pos, (*byte)("RUN   "))
		} else if p.State == PROC_READY {
			bufAppendStr(buf, &pos, (*byte)("READY "))
		} else if p.State == PROC_WAITING {
			bufAppendStr(buf, &pos, (*byte)("WAIT  "))
		} else if p.State == PROC_ZOMBIE {
			bufAppendStr(buf, &pos, (*byte)("ZOMB  "))
		} else if p.State == PROC_RUNNING {
			bufAppendStr(buf, &pos, (*byte)("RUN   "))
		} else {
			bufAppendStr(buf, &pos, (*byte)("???   "))
		}

		// SP ($XXXX)
		bufAppendByte(buf, &pos, '$')
		bufAppendHexWord(buf, &pos, p.SavedSP)
		bufAppendStr(buf, &pos, (*byte)("  "))

		// CMD
		if p.CmdName[0] != 0 {
			bufAppendStr(buf, &pos, &p.CmdName[0])
		} else {
			bufAppendStr(buf, &pos, (*byte)("-"))
		}
		bufAppendByte(buf, &pos, '\n')
	}

	pokeb(word(buf)+pos, 0)
	pd.FileSize = pos
	pd.FilePos = 0
	return 0
}

// ProcfsOpen dispatches /proc subpaths
func ProcfsOpen(pathId byte, pathStr *byte) byte {
	devType, _, remPath := dev.ParsePathDevice(pathStr, 0)
	if devType != dev.DEV_PROC {
		return path.E_PNNF
	}

	p := word(remPath)
	for peekb(p) == '/' {
		p++
	}

	var comp [16]byte
	idx := word(0)
	for idx < 15 {
		c := peekb(p + idx)
		if c == 0 || c == ' ' || c == '\r' || c == '\n' || c == '/' {
			break
		}
		comp[idx] = c
		idx++
	}
	comp[idx] = 0

	// Dispatch valid /proc paths
	if klib.streq(&comp[0], (*byte)("p")) {
		return ProcfsFormatProcesses(pathId)
	}

	// Additional valid paths to /proc can easily be added here later.

	return path.E_PNNF
}

