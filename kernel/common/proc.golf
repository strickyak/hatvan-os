package proc

import "hal"
import "klib"
import "rbf_ipc"
import "procfs_ipc"
import "dev"
import "path"
import "loader"
import "tables"

const MAX_PROCS = tables.MAX_PROCS
const PROC_MAX_PATHS = tables.PROC_MAX_PATHS

const PROC_FREE = 0
const PROC_READY = 1
const PROC_RUNNING = 2
const PROC_WAITING = 3
const PROC_ZOMBIE = 4

// OS-9 Error codes
const E_PNNF = 216      // Path name not found
const E_BPNUM = 217     // Bad path number
const E_PTHFUL = 218    // Path table full
const E_NOCHILD = 222   // No children
const E_NOTREADY = 223  // Child not ready
const E_PROCUNDEF = 224 // Process undefined / bad PID
const E_PROCFUL = 225   // Process table full

var CurrentPID byte

func GetProc(pid byte) *tables.Process {
	return &tables.Shared.ProcTable[pid]
}

func SetProcState(pid byte, newState byte) {
	if pid < MAX_PROCS {
		tables.Shared.ProcTable[pid].State = newState
	}
}

func SetCurrentPID(pid byte) {
	CurrentPID = pid
}

func IsAncestor(ancestor byte, pid byte) bool {
	curr := pid
	for curr > 0 && curr < MAX_PROCS {
		parent := tables.Shared.ProcTable[curr].ParentPID
		if parent == ancestor {
			return true
		}
		if parent == curr {
			break
		}
		curr = parent
	}
	return false
}

// ProcInit initializes the process subsystem
func ProcInit() {
	for i := word(0); i < MAX_PROCS; i++ {
		p := &tables.Shared.ProcTable[i]
		klib.memset((*byte)(p), 0, sizeof[tables.Process]())
		p.PID = byte(i)
		p.TaskID = byte(i)
		for k := word(0); k < PROC_MAX_PATHS; k++ {
			p.Paths[k] = 0xFF
		}
		if i > 2 {
			hal.PurgeTaskMem(byte(i))
		}
	}

	// Process 0 is Task 0 (Kernel)
	tables.Shared.ProcTable[0].State = PROC_RUNNING
	if hal.ARCH == '9' || hal.ARCH == 'z' {
		tables.Shared.ProcTable[0].SavedSP = 0x2000
	}
	klib.strcpy(&tables.Shared.ProcTable[0].CmdName[0], (*byte)("[hatvan-kernel]"))

	initDriverProc(1, (*byte)("[RBF]"))
	if hal.ARCH == '9' || hal.ARCH == 'z' {
		hal.InitRBF(0x4000)
	} else {
		hal.InitRBF(0x00001000)
	}

	initDriverProc(2, (*byte)("[PROCFS]"))
	if hal.ARCH == '9' || hal.ARCH == 'z' {
		hal.InitProcfs(0x4000)
	} else {
		hal.InitProcfs(0x00001000)
	}

	CurrentPID = 0
	ScheduleNext()
	hal.InitUserContext(0, 0, 0)
	hal.FreeUserContext(0)
}

func initDriverProc(pid byte, name *byte) {
	p := &tables.Shared.ProcTable[pid]
	p.State = PROC_WAITING
	p.ParentPID = 0
	p.TaskID = pid
	if hal.ARCH == '9' || hal.ARCH == 'z' {
		p.SavedSP = 0x3F00
	} else {
		p.SavedSP = 0x0007FE00
	}
	klib.strcpy(&p.CmdName[0], name)
	hal.SetTaskFlags(pid, 1)
}

func inheritParent(p *tables.Process, parent *tables.Process) {
	p.CwdDrive = parent.CwdDrive
	p.CwdFDLSN = parent.CwdFDLSN
	klib.strcpy(&p.CwdPath[0], &parent.CwdPath[0])
	p.CxdDrive = parent.CxdDrive
	p.CxdFDLSN = parent.CxdFDLSN
	klib.strcpy(&p.CxdPath[0], &parent.CxdPath[0])
	p.LineMode = parent.LineMode

	for sp := word(0); sp < 4; sp++ {
		parentPathId := parent.Paths[sp]
		if parentPathId != 0xFF && parentPathId < path.MAX_PATHS {
			p.Paths[sp] = parentPathId
			path.GetPath(parentPathId).RefCount++
		}
	}
}

// ProcAlloc finds a free process slot and initializes it,
// inheriting cwd, cxd, lineMode, and standard paths 0, 1, 2, 3 (stdin, stdout, stderr, stdlog).
func ProcAlloc(parentPID byte) byte {
	for i := word(1); i < MAX_PROCS; i++ {
		if tables.Shared.ProcTable[i].State == PROC_FREE {
			p := &tables.Shared.ProcTable[i]
			klib.memset((*byte)(p), 0, sizeof[tables.Process]())
			p.PID = byte(i)
			p.TaskID = byte(i)
			p.State = PROC_READY
			p.ParentPID = parentPID
			if hal.ARCH == 'k' {
				p.SavedSP = 0x0007FE00
			} else {
				p.SavedSP = 0xFE00
			}
			for k := word(0); k < PROC_MAX_PATHS; k++ {
				p.Paths[k] = 0xFF
			}

			if parentPID < MAX_PROCS && tables.Shared.ProcTable[parentPID].State != PROC_FREE {
				inheritParent(p, &tables.Shared.ProcTable[parentPID])
			}
			return byte(i)
		}
	}
	return 0xFF
}

func closeAllProcPaths(p *tables.Process) {
	for k := word(0); k < PROC_MAX_PATHS; k++ {
		pathId := p.Paths[k]
		if pathId != 0xFF {
			path.SysClose(pathId)
			p.Paths[k] = 0xFF
		}
	}
}

// ProcFree terminates a process slot and closes all associated paths
func ProcFree(pid byte) {
	if pid <= 2 || pid >= MAX_PROCS {
		return
	}
	p := &tables.Shared.ProcTable[pid]
	closeAllProcPaths(p)
	p.State = PROC_FREE
	hal.PurgeTaskMem(p.TaskID)
	hal.FreeUserContext(pid)
}

var AssignedSlot byte

func findFreePathSlot(p *tables.Process) byte {
	for k := word(0); k < PROC_MAX_PATHS; k++ {
		if p.Paths[k] == 0xFF {
			return byte(k)
		}
	}
	return 0xFF
}

// ProcOpen opens a path for the given process and assigns a per-process path descriptor
func ProcOpen(pid byte, pathStr *byte, mode byte) byte {
	if pid >= MAX_PROCS || tables.Shared.ProcTable[pid].State == PROC_FREE {
		return E_PROCUNDEF
	}
	p := &tables.Shared.ProcTable[pid]
	slot := findFreePathSlot(p)
	if slot == 0xFF {
		return E_PTHFUL
	}

	err := path.SysOpen(pid, pathStr, mode, p.CwdDrive, p.CwdFDLSN, p.CxdFDLSN)
	if err != 0 {
		return err
	}
	pathId := path.AllocatedPathId

	if path.GetPath(pathId).DevType == dev.DEV_PROC {
		perr := ProcfsOpen(pathId, pathStr)
		if perr != 0 {
			path.SysClose(pathId)
			return perr
		}
	}

	p.Paths[slot] = pathId
	AssignedSlot = slot
	return 0
}

// ProcCreate creates or opens a path for writing for the given process
func ProcCreate(pid byte, pathStr *byte, mode byte) byte {
	if pid >= MAX_PROCS || tables.Shared.ProcTable[pid].State == PROC_FREE {
		return E_PROCUNDEF
	}
	p := &tables.Shared.ProcTable[pid]
	slot := findFreePathSlot(p)
	if slot == 0xFF {
		return E_PTHFUL
	}

	err := path.SysCreate(pid, pathStr, mode, p.CwdDrive, p.CwdFDLSN, p.CxdFDLSN)
	if err != 0 {
		return err
	}
	pathId := path.AllocatedPathId

	p.Paths[slot] = pathId
	AssignedSlot = slot
	return 0
}

// ProcDelete deletes a file for the given process
func ProcDelete(pid byte, pathStr *byte) byte {
	if pid >= MAX_PROCS || tables.Shared.ProcTable[pid].State == PROC_FREE {
		return E_PROCUNDEF
	}
	p := &tables.Shared.ProcTable[pid]
	return path.SysDelete(pid, pathStr, p.CwdDrive, p.CwdFDLSN, p.CxdFDLSN)
}

// ProcClose closes a per-process path descriptor
func ProcClose(pid byte, procPath byte) byte {
	if pid >= MAX_PROCS || tables.Shared.ProcTable[pid].State == PROC_FREE {
		return E_PROCUNDEF
	}
	if procPath >= PROC_MAX_PATHS {
		return E_BPNUM
	}
	p := &tables.Shared.ProcTable[pid]
	pathId := p.Paths[procPath]
	if pathId == 0xFF {
		return E_BPNUM
	}

	path.SysClose(pathId)
	p.Paths[procPath] = 0xFF
	return 0
}

// ProcDup duplicates an open path, assigning the lowest available path slot
func ProcDup(pid byte, procPath byte) byte {
	if pid >= MAX_PROCS || tables.Shared.ProcTable[pid].State == PROC_FREE {
		return E_PROCUNDEF
	}
	if procPath >= PROC_MAX_PATHS {
		return E_BPNUM
	}
	p := &tables.Shared.ProcTable[pid]
	pathId := p.Paths[procPath]
	if pathId == 0xFF {
		return E_BPNUM
	}

	slot := findFreePathSlot(p)
	if slot == 0xFF {
		return E_PTHFUL
	}

	err := path.SysDup(pathId)
	if err != 0 {
		return err
	}

	p.Paths[slot] = pathId
	AssignedSlot = slot
	return 0
}

// GetProcPath returns the pathId for a given process slot, or 0xFF if invalid
func GetProcPath(pid byte, procPath byte) byte {
	if pid < MAX_PROCS && tables.Shared.ProcTable[pid].State != PROC_FREE {
		if procPath < PROC_MAX_PATHS {
			return tables.Shared.ProcTable[pid].Paths[procPath]
		}
	}
	return 0xFF
}

// extractCmdName copies the basename of cmdPath (without directory prefix) into dst (up to 15 chars)
func extractCmdName(src *byte, dst *byte) {
	s := word(src)
	start := s
	for {
		c := peekb(s)
		if c == 0 || c == ' ' || c == '\r' || c == '\n' {
			break
		}
		if c == '/' {
			start = s + 1
		}
		s++
	}
	idx := word(0)
	for idx < 15 {
		c := peekb(start + idx)
		if c == 0 || c == ' ' || c == '\r' || c == '\n' || c == '/' {
			break
		}
		pokeb(word(dst)+idx, c)
		idx++
	}
	pokeb(word(dst)+idx, 0)
}

var ForkedChildPID byte

func finishChildSetup(childProc *tables.Process, entryPC word, binSize word, paramStr *byte, paramLen word) {
	childProc.LineMode = loader.LastLoadedIsOS9
	childProc.SavedSP = hal.SetupChildTask(childProc.TaskID, childProc.LineMode, entryPC, binSize, paramStr, paramLen)
	childProc.CodeStart = hal.ChildCodeStart
	childProc.SavedPC = entryPC
	childProc.CodeSize = binSize
	childProc.State = PROC_READY
	hal.InitUserContext(childProc.PID, childProc.SavedSP, entryPC)
}

// SysFork spawns a child process, loads the binary executable from cmdPath,
// marshalls command parameters onto the child stack, and prepares it for execution.
func SysFork(cmdPath *byte, paramStr *byte, paramLen word) byte {
	childPID := ProcAlloc(CurrentPID)
	if childPID == 0xFF {
		ForkedChildPID = 0xFF
		return E_PROCFUL
	}
	childProc := &tables.Shared.ProcTable[childPID]
	extractCmdName(cmdPath, &childProc.CmdName[0])

	// Open binary from cxd (execution directory) or absolute path
	err := path.SysOpen(CurrentPID, cmdPath, path.MODE_READ|path.MODE_EXEC, childProc.CxdDrive, childProc.CwdFDLSN, childProc.CxdFDLSN)
	if err != 0 {
		if err == 216 {
			dev.KLog((*byte)("FORK:OPEN:FAIL:PNNF"))
		} else if err == 214 {
			dev.KLog((*byte)("FORK:OPEN:FAIL:BMODE"))
		} else if err == 208 {
			dev.KLog((*byte)("FORK:OPEN:FAIL:PTHFUL"))
		} else {
			dev.KLog((*byte)("FORK:OPEN:FAIL:OTHER"))
		}
		ProcFree(childPID)
		ForkedChildPID = 0xFF
		return err
	}
	binPathId := path.AllocatedPathId

	// Load binary into child task space
	lerr := loader.LoadBinary(binPathId, childProc.TaskID, 0x0200)
	path.SysClose(binPathId)
	if lerr != 0 {
		dev.KLog((*byte)("FORK:LOAD:FAIL"))
		ProcFree(childPID)
		ForkedChildPID = 0xFF
		return lerr
	}
	entryPC := loader.LoadedEntryPC
	binSize := loader.LoadedSize

	finishChildSetup(childProc, entryPC, binSize, paramStr, paramLen)

	ForkedChildPID = childPID
	return 0
}

// SysExit terminates the current process and records its exit status
func SysExit(status byte) {
	if CurrentPID == 0 {
		hal.Exit(status)
		return
	}

	p := &tables.Shared.ProcTable[CurrentPID]
	closeAllProcPaths(p)
	p.ExitStatus = status
	SetProcState(CurrentPID, PROC_ZOMBIE)
	hal.PurgeTaskMem(p.TaskID)

	// Wake parent if waiting
	if p.ParentPID < MAX_PROCS && tables.Shared.ProcTable[p.ParentPID].State == PROC_WAITING {
		SetProcState(p.ParentPID, PROC_READY)
	}
}

var WaitChildPID byte
var WaitStatus byte

func reapChild(p *tables.Process, cpid byte) byte {
	WaitChildPID = cpid
	WaitStatus = p.ExitStatus
	ProcFree(cpid)
	SetProcState(CurrentPID, PROC_RUNNING)
	return 0
}

// SysWait waits for any child process to terminate and returns errCode (0 on success)
func SysWait() byte {
	for {
		hasChildren := false

		for i := word(1); i < MAX_PROCS; i++ {
			p := &tables.Shared.ProcTable[i]
			if p.ParentPID == CurrentPID && p.State != PROC_FREE {
				hasChildren = true
				if p.State == PROC_ZOMBIE {
					return reapChild(p, byte(i))
				}
				if p.State == PROC_READY || p.State == PROC_RUNNING {
					SetProcState(CurrentPID, PROC_WAITING)
					hal.LaunchProcess(byte(i), p.SavedSP, p.SavedPC)
					if p.State == PROC_ZOMBIE {
						return reapChild(p, byte(i))
					}
				}
			}
		}

		if !hasChildren {
			SetProcState(CurrentPID, PROC_RUNNING)
			return E_NOCHILD
		}

		// If children exist but none is ready/zombie, let any ready/running process run
		WaitInput()
	}
}

func updateProcPath(dstPath *byte, pathStr *byte, drive byte) {
	dPath := word(dstPath)
	pStr := word(pathStr)
	if peekb(pStr) == '/' {
		if peekb(pStr+1) == 'd' && peekb(pStr+2) >= '0' && peekb(pStr+2) <= '3' {
			klib.strcpy(dstPath, pathStr)
			return
		}
		pokeb(dPath, '/')
		pokeb(dPath+1, 'd')
		pokeb(dPath+2, '0'+drive)
		klib.strcpy((*byte)(dPath+3), pathStr)
		return
	}
	curLen := klib.strlen(dstPath)
	if curLen > 0 && peekb(dPath+curLen-1) != '/' && curLen < 62 {
		pokeb(dPath+curLen, '/')
		curLen++
		pokeb(dPath+curLen, 0)
	}
	for peekb(pStr) != 0 && curLen < 63 {
		pokeb(dPath+curLen, peekb(pStr))
		curLen++
		pStr++
	}
	pokeb(dPath+curLen, 0)
}

// SysChgDir changes the current working directory (cwd) or execution directory (cxd)
func SysChgDir(pathStr *byte, mode byte) byte {
	p := &tables.Shared.ProcTable[CurrentPID]
	devType := dev.ParsePathDevice(pathStr, p.CwdDrive)
	if devType != dev.DEV_DISK {
		return path.E_BMODE
	}

	isExec := byte(0)
	if (mode & path.MODE_EXEC) != 0 {
		isExec = 1
	}

	err := rbf_ipc.ResolvePath(pathStr, p.CwdDrive, p.CwdFDLSN, p.CxdFDLSN, isExec)
	if err != 0 {
		dev.KLog((*byte)("CHGDIR:RBF_ERR"))
		return path.E_PNNF
	}
	if rbf_ipc.ResDrive == 0xFF || rbf_ipc.ResFDLSN == 0 {
		dev.KLog((*byte)("CHGDIR:RES_NULL"))
		return path.E_PNNF
	}

	if (rbf_ipc.ResAttr & 0x80) == 0 {
		dev.KLog((*byte)("CHGDIR:NOT_DIR"))
		return path.E_BMODE
	}

	if isExec != 0 {
		p.CxdDrive = rbf_ipc.ResDrive
		p.CxdFDLSN = rbf_ipc.ResFDLSN
		updateProcPath(&p.CxdPath[0], pathStr, rbf_ipc.ResDrive)
	} else {
		p.CwdDrive = rbf_ipc.ResDrive
		p.CwdFDLSN = rbf_ipc.ResFDLSN
		updateProcPath(&p.CwdPath[0], pathStr, rbf_ipc.ResDrive)
	}

	return 0
}

// ==================== /proc Filesystem ====================

// ProcfsOpen dispatches /proc subpaths via Task 2 IPC
func ProcfsOpen(pathId byte, pathStr *byte) byte {
	devType := dev.ParsePathDevice(pathStr, 0)
	remPath := dev.ParsedRemPath
	if devType != dev.DEV_PROC {
		return path.E_PNNF
	}

	p := word(remPath)
	for peekb(p) == '/' {
		p++
	}

	var comp [16]byte
	idx := word(0)
	for idx < 15 {
		c := peekb(p + idx)
		if c == 0 || c == ' ' || c == '\r' || c == '\n' || c == '/' {
			break
		}
		comp[idx] = c
		idx++
	}
	comp[idx] = 0

	err := procfs_ipc.Open(&comp[0], CurrentPID)
	if err != 0 {
		return err
	}

	pd := path.GetPath(pathId)
	pd.FileSize = procfs_ipc.ResFileSize
	pd.FilePos = 0
	return 0
}

// ScheduleNext selects the next runnable process (PROC_READY or PROC_RUNNING) in round-robin order.
func ScheduleNext() byte {
	start := CurrentPID
	for offset := word(1); offset <= MAX_PROCS; offset++ {
		next := byte((word(start) + offset) % MAX_PROCS)
		if next <= 2 {
			continue
		}
		if tables.Shared.ProcTable[next].State == PROC_READY || tables.Shared.ProcTable[next].State == PROC_RUNNING {
			if start >= 3 && tables.Shared.ProcTable[start].State == PROC_RUNNING {
				SetProcState(start, PROC_READY)
			}
			SetProcState(next, PROC_RUNNING)
			return next
		}
	}
	return CurrentPID
}

// Yield gives CPU time to any other ready process.
func Yield() {
	for i := word(3); i < MAX_PROCS; i++ {
		p := GetProc(byte(i))
		if byte(i) != CurrentPID && !IsAncestor(byte(i), CurrentPID) && (p.State == PROC_READY || p.State == PROC_RUNNING) {
			hal.LaunchProcess(byte(i), p.SavedSP, p.SavedPC)
			return
		}
	}
}

// WaitInput sets the current process to PROC_WAITING and yields the CPU.
func WaitInput() {
	if CurrentPID < MAX_PROCS {
		SetProcState(CurrentPID, PROC_WAITING)
	}
	Yield()
	if CurrentPID < MAX_PROCS {
		SetProcState(CurrentPID, PROC_RUNNING)
	}
}


