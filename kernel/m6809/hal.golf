package hal

const ARCH = '9'
const SHARED_MEM_CURTAIN = 0xE000

// Hardware ports for M6809 Hatvan VM ($FF00 page in Task 0)
const PORT_TERMOUT = 0xFF00
const PORT_TERMIN = 0xFF01
const PORT_REGSTAT = 0xFF02
const PORT_REGCTRL = 0xFF03
const PORT_LOGCHAR = 0xFF04
const PORT_EXIT = 0xFF05

const PORT_DISKDRV = 0xFF10
const PORT_DISKSEC0 = 0xFF11
const PORT_DISKSEC1 = 0xFF12
const PORT_DISKSEC2 = 0xFF13
const PORT_DISKTASK = 0xFF14
const PORT_DISKADDR = 0xFF15 // 2 bytes (Hi, Lo)
const PORT_DISKCMD = 0xFF17

const PORT_TASKFUSE = 0xFF20

const PORT_DMASRCTASK = 0xFF21
const PORT_DMASRCPAGE = 0xFF22
const PORT_DMASRCADDR = 0xFF23 // 2 bytes (Hi, Lo)
const PORT_DMADSTTASK = 0xFF25
const PORT_DMADSTPAGE = 0xFF26
const PORT_DMADSTADDR = 0xFF27 // 2 bytes (Hi, Lo)
const PORT_DMACNT = 0xFF29
const PORT_DMASTATUS = 0xFF2A
const PORT_SHAREDCURTAIN = 0xFF2B // 2 bytes (Hi, Lo)

const PORT_TASKFLAGSTASK = 0xFF2D
const PORT_TASKFLAGS = 0xFF2E
const PORT_PURGETASKMEM = 0xFF2F

func GetSharedCurtain() word {
	hi := word(vpeekb(PORT_SHAREDCURTAIN))
	lo := word(vpeekb(PORT_SHAREDCURTAIN + 1))
	return (hi << 8) | lo
}

func PutChar(b byte) {
	vpokeb(PORT_TERMOUT, b)
}

func GetChar() byte {
	return vpeekb(PORT_TERMIN)
}

func LogChar(b byte) {
	vpokeb(PORT_LOGCHAR, b)
}

func EnableTimer() {
	vpokeb(PORT_REGCTRL, 3)
}

func DisableTimer() {
	vpokeb(PORT_REGCTRL, 0)
}

func Exit(code byte) {
	vpokeb(PORT_EXIT, code)
	for {
	}
}

func DiskTransfer(drive byte, lsn word, task byte, addr word, isWrite byte) byte {
	vpokeb(PORT_DISKDRV, drive)
	vpokeb(PORT_DISKSEC0, 0)
	vpokeb(PORT_DISKSEC1, byte(lsn>>8))
	vpokeb(PORT_DISKSEC2, byte(lsn))
	vpokeb(PORT_DISKTASK, task)
	vpokew(PORT_DISKADDR, addr)

	cmd := byte(1) // 1 = Read
	if isWrite != 0 {
		cmd = 2 // 2 = Write
	}
	vpokeb(PORT_DISKCMD, cmd)

	// Busy-wait for completion
	for {
		st := vpeekb(PORT_DISKCMD)
		if st > 0 {
			return st
		}
	}
}

func DMACopyPage(srcTask byte, srcPage byte, srcAddr word, dstTask byte, dstPage byte, dstAddr word, count word) {
	for count > 0 {
		chunk := count
		if chunk > 256 {
			chunk = 256
		}

		vpokeb(PORT_DMASRCTASK, srcTask)
		vpokeb(PORT_DMASRCPAGE, srcPage)
		vpokew(PORT_DMASRCADDR, srcAddr)
		vpokeb(PORT_DMADSTTASK, dstTask)
		vpokeb(PORT_DMADSTPAGE, dstPage)
		vpokew(PORT_DMADSTADDR, dstAddr)

		cntByte := byte(chunk)
		if chunk == 256 {
			cntByte = 0
		}
		vpokeb(PORT_DMACNT, cntByte)

		// Wait for completion
		for vpeekb(PORT_DMACNT) == 0 {
		}

		count -= chunk
		srcAddr += chunk
		dstAddr += chunk
	}
}

func DMACopy(srcTask byte, srcAddr word, dstTask byte, dstAddr word, count word) {
	DMACopyPage(srcTask, 0, srcAddr, dstTask, 0, dstAddr, count)
}

func SwitchTask(task byte) {
	vpokeb(PORT_TASKFUSE, task)
}

func LaunchProcess(pid byte, sp word, pc word)

func HasInput() bool {
	return (vpeekb(PORT_REGSTAT) & 2) != 0
}

func PurgeTaskMem(task byte) {
	if task != 0 {
		vpokeb(PORT_PURGETASKMEM, task)
	}
}

func SetTaskFlags(task byte, flags byte) {
	vpokeb(PORT_TASKFLAGSTASK, task)
	vpokeb(PORT_TASKFLAGS, flags)
}

func RBFCall()
func Sleep()
func InitRBF(entryPC word)
func ProcfsCall()
func InitProcfs(entryPC word)
func InitUserContext(pid byte, sp word, pc word)
func FreeUserContext(pid byte)

var ChildCodeStart word

func SetupChildTask(taskID byte, lineMode byte, entryPC word, binSize word, paramStr *byte, paramLen word) word {
	codeStart := word(0x0200)
	dpVal := byte(0)
	uVal := word(0)
	paramEnd := word(0xFE00)

	if lineMode == 1 {
		codeStart = 0xFF00 - binSize
		paramEnd = codeStart & 0xFF00
		dpVal = 0
		uVal = 0
	}

	sp := paramEnd
	paramAddr := paramEnd
	paramLenVal := word(0)
	if paramStr != (*byte)(0) && paramLen > 0 {
		sp -= (paramLen + 1)
		sp &^= 1
		DMACopy(0, word(paramStr), taskID, sp, paramLen)
		cr := byte('\r')
		DMACopy(0, word(&cr), taskID, sp+paramLen, 1)
		paramAddr = sp
		paramLenVal = paramLen
	}

	frameAddr := sp - 12
	var initFrame [12]byte
	initFrame[0] = 0x80                   // CC: FlagE (Entire frame)
	initFrame[1] = byte(paramLenVal >> 8) // A (D MSB: paramLenVal)
	initFrame[2] = byte(paramLenVal)      // B (D LSB: paramLenVal)
	initFrame[3] = dpVal                  // DP (0x00)
	initFrame[4] = byte(paramAddr >> 8)   // X MSB (parameter pointer)
	initFrame[5] = byte(paramAddr)        // X LSB
	initFrame[6] = byte(paramEnd >> 8)    // Y MSB (paramEnd: top of user memory)
	initFrame[7] = byte(paramEnd)         // Y LSB
	initFrame[8] = byte(uVal >> 8)        // U MSB (0x0000: process data area)
	initFrame[9] = byte(uVal)             // U LSB
	initFrame[10] = byte(entryPC >> 8)    // PC MSB
	initFrame[11] = byte(entryPC)         // PC LSB

	DMACopy(0, word(&initFrame[0]), taskID, frameAddr, 12)
	ChildCodeStart = codeStart
	return frameAddr
}


